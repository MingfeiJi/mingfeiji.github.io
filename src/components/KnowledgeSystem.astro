---
import KnowledgeGraph from './KnowledgeGraph.astro';
import graph from '../data/graph.json';
import { knowledgeSnapshot as snapshot, knowledgeLayers, ontologyNodes, collaborationLoop } from '../data/knowledge';
const stats = [
  { value: snapshot.markdown.toLocaleString('en-US'), label: '可见 Markdown 文件' },
  { value: String(snapshot.concepts), label: 'Wiki 概念页' },
  { value: String(snapshot.methods), label: 'Wiki 方法页' },
  { value: snapshot.outputs.toLocaleString('en-US'), label: '产出物 Markdown 文档' },
];
---
<section class="chapter knowledge-system" id="knowledge" aria-labelledby="knowledge-title">
  <div class="wrap">
    <header class="chapter-head reveal">
      <div class="ch-no"><em>09</em> PERSONAL KNOWLEDGE SYSTEM</div>
      <h2 id="knowledge-title">个人本体，让知识参与行动。</h2>
      <p class="ch-sub">在 Obsidian 中连接来源、概念、方法、项目与作品，逐步形成我的个人知识本体。让 Codex 的执行、Grokbot 的对话协作与日常复盘，共用一份可以追溯、持续修订的上下文。</p>
      <div class="knowledge-jumps"><a href="#knowledge-ontology">探索本体关系 ↓</a><a href="#knowledge-loop">查看协作循环 ↓</a></div>
    </header>

    <div class="knowledge-stats reveal" aria-label="知识库文件快照">
      {stats.map(stat => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
    </div>
    <details class="snapshot-scope">
      <summary>{snapshot.date} 文件快照 <span>查看统计范围 ↗</span></summary>
      <p>统计五类资料目录的可见 Markdown 文件，含历史存档；排除隐藏目录、凭证、依赖、备份、维护审计与 AI 工具对话存档目录。私人 RSI 单列，不计入 14,109。文件数量未经内容去重，不等于独立知识点、已阅读量或已发布作品量；概念、方法与产出物是其中的子集。</p>
    </details>

    <div class="ontology-panel reveal" id="knowledge-ontology" data-ontology>
      <div class="panel-heading"><div><span class="micro">PERSONAL ONTOLOGY</span><h3>有对象，也有关系。</h3></div><span class="panel-note">结构示意 · 点击节点</span></div>
      <div class="ontology-layout">
        <div class="ontology-map" role="group" aria-label="选择个人本体中的知识对象">
          <svg class="ontology-edges" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
            <path d="M250 114 H750 M750 114 L850 324 L750 516 H250 L150 324 L250 114" />
            <path class="return-edge" d="M150 324 Q350 60 750 114" />
            <path class="inner-edges" d="M250 114 L500 300 L750 114 M850 324 L500 300 L750 516 M250 516 L500 300 L150 324" />
          </svg>
          <div class="ontology-center"><span>MINGFEI JI</span><strong>个人本体</strong><small>问题 · 判断 · 行动</small></div>
          {ontologyNodes.map(node => <button type="button" class="ontology-node" style={`--x:${node.x}%;--y:${node.y}%`} data-node={node.id} aria-pressed={node.id === 'concept' ? 'true' : 'false'} aria-controls={`ontology-detail-${node.id}`}><small>{node.en}</small><span>{node.name}</span></button>)}
          <span class="edge-label top">支持 / 反驳 →</span><span class="edge-label bottom">← 产出 / 回看</span>
        </div>
        <div class="ontology-details" aria-live="polite">
          {ontologyNodes.map(node => <article id={`ontology-detail-${node.id}`} data-node-detail={node.id} hidden={node.id !== 'concept'}>
            <span class="micro">{node.en}</span><h4>{node.title}</h4><p>{node.detail}</p>
            <div class="relation">{node.relation}</div><div class="field-list">{node.fields.map(field => <span>{field}</span>)}</div>
            <p class="detail-note">{node.note}</p>
          </article>)}
        </div>
      </div>
      <p class="ontology-caption">这张图呈现知识对象与关系的组织方式。具体判断仍以真实来源、关系理由和复核状态为依据。</p>
      <noscript><p class="ontology-caption">完整路径：来源支持或反驳概念，概念组织为方法，方法应用于项目，项目产出作品，作品反馈推动概念与方法修订。</p></noscript>
    </div>

    <div class="loop-panel reveal" id="knowledge-loop">
      <div class="panel-heading"><div><span class="micro">HUMAN × AGENT × KNOWLEDGE</span><h3>让每次交付，回到下一次判断。</h3></div><span class="panel-note">协作流程 · 持续完善</span></div>
      <div class="tool-roles"><span><b>Grokbot</b> 对话与任务入口</span><span><b>Codex</b> 执行与校验</span><span><b>Obsidian</b> 长期知识与上下文</span></div>
      <ol class="loop-flow">{collaborationLoop.map(step => <li><span class="step-number">{step.step}</span><h4>{step.title}</h4><span class="step-owner">{step.owner}</span><p>{step.description}</p></li>)}</ol>
      <div class="loop-return"><span>↶</span> 纠错、反例与实际结果，回到下一轮问题与上下文 <span>↵</span></div>
      <div class="loop-status"><p><strong>已配置</strong>资料采集与 Codex 日批，沿来源、队列与版本记录接续。</p><p><strong>持续完善</strong>跨工具自动接续与语义验收；核心判断和发布由本人确认。</p></div>
      <p class="loop-boundary">流程图表达协作分工，不代表三端已实现无人值守全自动运行。自动化配置、实际执行、本人采用与外部结果分别记录。</p>
    </div>

    <div class="layer-heading"><span class="micro">THE KNOWLEDGE LAYERS</span><h3>五类资料，连着一条个人演化线。</h3><p>营销增长、内容生产、AI / Agent 工程、业务项目、课程与投资，按问题进入，按职责沉淀。</p></div>
    <div class="knowledge-layers" data-stagger>{knowledgeLayers.map(layer => <article class="knowledge-layer"><div class="layer-name"><span>{layer.code}</span><h4>{layer.name}</h4></div><div class="layer-count">{layer.count}<small>{layer.unit}</small></div><p>{layer.description}</p></article>)}</div>

    <div class="public-graph reveal">
      <div class="panel-heading"><div><span class="micro">PUBLIC KNOWLEDGE SELECTION</span><h3>从公开文章，走进知识网络。</h3></div><a href="/graph/">全屏探索 ↗</a></div>
      <p class="graph-description">{graph.nodes.length} 个公开节点 · {graph.links.length} 条关联。点击节点进入本站文章与资料；这是公开选集，不是本地知识库或私人 RSI 的全量镜像。</p>
      <KnowledgeGraph height="440px" label="KNOWLEDGE GRAPH · PUBLIC SELECTION" />
      <div class="knowledge-links"><a href="/library/">藏书阁 · 浏览主题收藏 ↗</a><a href="/files/philosophical-dialogues.pdf" target="_blank" rel="noopener">哲学对话 · 阅读公开整理 ↗</a></div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-ontology]').forEach(root => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-node]');
    const details = root.querySelectorAll<HTMLElement>('[data-node-detail]');
    buttons.forEach(button => button.addEventListener('click', () => {
      const selected = button.dataset.node;
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      details.forEach(item => item.hidden = item.dataset.nodeDetail !== selected);
    }));
  });
</script>
<style>
  .knowledge-system{--ks-fill:rgba(10,14,25,.69);--ks-line:rgba(181,194,217,.23);--ks-accent:#b9c9ef;--ks-soft:rgba(178,198,238,.075);--ks-muted:#a5adc3}
  .knowledge-system,.ontology-panel,.loop-panel{scroll-margin-top:90px}.knowledge-jumps{display:flex;flex-wrap:wrap;gap:24px;margin-top:19px;font-size:12px}.knowledge-jumps a{color:var(--ink2);border-bottom:1px solid var(--ks-line);padding-bottom:4px}.knowledge-jumps a:hover{color:var(--ink)}
  .knowledge-system .chapter-head{margin-bottom:34px}.knowledge-system .ch-sub{max-width:850px;line-height:2}.knowledge-stats{display:grid;grid-template-columns:1.45fr 1fr 1fr 1.3fr;border:1px solid var(--ks-line);border-radius:16px;background:var(--ks-fill);overflow:hidden}.knowledge-stats>div{padding:27px 30px;border-right:1px solid var(--ks-line)}.knowledge-stats>div:last-child{border:0}.knowledge-stats strong{display:block;font:500 clamp(28px,3vw,39px)/1.2 var(--mono);color:var(--ink)}.knowledge-stats span{display:block;margin-top:12px;font-size:12px;color:var(--ink2)}.snapshot-scope{margin:15px 0 35px;color:var(--ks-muted);font-size:11px;line-height:1.9}.snapshot-scope summary{cursor:pointer;list-style:none;font-family:var(--mono)}.snapshot-scope summary span{margin-left:14px;color:var(--ink2)}.snapshot-scope p{max-width:900px;padding:12px 0;color:var(--ink2)}
  .ontology-panel,.loop-panel{border:1px solid var(--ks-line);border-radius:16px;background:var(--ks-fill);padding:30px;overflow:hidden}.panel-heading{display:flex;justify-content:space-between;align-items:center;gap:20px}.micro{font:9px/1.8 var(--mono);letter-spacing:.15em;color:var(--ks-accent)}.panel-heading h3,.layer-heading h3{font-family:var(--serif);font-size:25px;line-height:1.6;color:var(--ink);margin:7px 0 0}.panel-note{font-size:10px;white-space:nowrap;color:var(--ks-muted)}.ontology-layout{display:grid;grid-template-columns:1.5fr 1fr;gap:30px;align-items:center;margin-top:18px}.ontology-map{height:360px;position:relative;min-width:0}.ontology-edges{position:absolute;width:100%;height:100%;inset:0;fill:none;stroke:var(--ks-accent);stroke-opacity:.3;stroke-width:1.2;vector-effect:non-scaling-stroke}.ontology-edges .inner-edges{stroke-opacity:.17;stroke-dasharray:4 6}.ontology-edges .return-edge{stroke-opacity:.17}.ontology-center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:155px;height:126px;display:flex;align-items:center;justify-content:center;flex-direction:column;border:1px solid var(--ks-line);border-radius:50%;background:radial-gradient(ellipse,var(--ks-soft),transparent 70%)}.ontology-center>span{font:8px var(--mono);letter-spacing:.15em;color:var(--ks-muted)}.ontology-center strong{font:24px/1.6 var(--serif);color:var(--ink);margin:5px 0}.ontology-center small{font-size:10px;color:var(--ink2)}.ontology-node{position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);width:124px;padding:11px 8px;border:1px solid var(--ks-line);border-radius:9px;background:var(--space-1,#0c1327);color:var(--ink2);cursor:pointer;transition:border-color .2s,background .2s}.ontology-node small{display:block;font:8px var(--mono);letter-spacing:.12em;color:var(--ks-muted);margin-bottom:5px}.ontology-node>span{font:14px/1.5 var(--serif);white-space:nowrap}.ontology-node[aria-pressed=true]{border-color:var(--ks-accent);background:color-mix(in srgb,var(--space-1) 70%,var(--ks-accent) 30%);color:var(--ink)}.ontology-node[aria-pressed=true] small{color:var(--ks-accent)}.ontology-node:hover{border-color:var(--ks-accent)}.ontology-node:focus-visible,.snapshot-scope summary:focus-visible{outline:2px solid var(--ks-accent);outline-offset:4px}.edge-label{position:absolute;left:50%;transform:translateX(-50%);font-size:9px;letter-spacing:.08em;color:var(--ks-muted);white-space:nowrap}.edge-label.top{top:13%}.edge-label.bottom{bottom:8%}.ontology-details{min-width:0;border-left:1px solid var(--ks-line);padding:18px 0 18px 28px;min-height:290px}.ontology-details h4{font:21px/1.65 var(--serif);color:var(--ink);margin:10px 0 12px}.ontology-details p{font-size:13px;line-height:1.95;color:var(--ink2)}.relation{font-size:11px;line-height:1.9;margin:20px 0 15px;padding:10px 12px;border-left:2px solid var(--ks-accent);background:var(--ks-soft);color:var(--ink)}.field-list{display:flex;flex-wrap:wrap;gap:7px}.field-list span{font-size:9px;color:var(--ink2);border:1px solid var(--ks-line);border-radius:4px;padding:4px 7px}.ontology-details .detail-note{font-size:11px;margin-top:17px;color:var(--ks-muted)}.ontology-caption{padding-top:14px;margin-top:12px;border-top:1px solid var(--ks-line);font-size:10px;line-height:1.9;color:var(--ks-muted)}
  .loop-panel{margin-top:28px}.tool-roles{display:flex;flex-wrap:wrap;gap:14px 24px;margin:23px 0 30px;font-size:11px;color:var(--ks-muted)}.tool-roles b{font:12px var(--mono);color:var(--ink);margin-right:8px}.loop-flow{padding:0;margin:0;list-style:none;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:22px}.loop-flow li{position:relative;border-top:1px solid var(--ks-line);padding:18px 0 7px;min-width:0}.loop-flow li:not(:last-child)::after{content:'→';position:absolute;right:-16px;top:45px;font-size:15px;color:var(--ks-accent)}.step-number{font:10px var(--mono);color:var(--ks-muted)}.loop-flow h4{font:18px/1.6 var(--serif);margin:9px 0 10px;color:var(--ink)}.step-owner{font-size:10px;color:var(--ks-accent)}.loop-flow p{font-size:12px;line-height:1.9;color:var(--ink2);margin-top:10px}.loop-return{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid var(--ks-line);border-top:0;border-radius:0 0 13px 13px;margin-top:18px;padding:9px 17px;color:var(--ks-accent);font-size:10px;letter-spacing:.05em}.loop-return span{font-size:21px}.loop-status{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px}.loop-status p{font-size:11px;line-height:1.9;color:var(--ink2)}.loop-status strong{font-size:10px;color:var(--ink);margin-right:9px;border:1px solid var(--ks-line);border-radius:4px;padding:3px 6px;white-space:nowrap}.loop-boundary{font-size:10px;color:var(--ks-muted);line-height:1.9;margin-top:14px}
  .layer-heading{margin:48px 0 24px}.layer-heading p{font-size:13px;color:var(--ink2);line-height:1.9;margin-top:10px}.knowledge-layers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.knowledge-layer{border:1px solid var(--ks-line);background:var(--ks-fill);border-radius:12px;padding:24px}.layer-name{display:flex;gap:13px;align-items:center}.layer-name>span{font:10px var(--mono);color:var(--ks-accent)}.layer-name h4{font:20px/1.6 var(--serif);color:var(--ink)}.layer-count{font:20px/1.6 var(--mono);color:var(--ink);margin:17px 0 12px}.layer-count small{display:block;font:10px/1.7 var(--mono);color:var(--ks-muted);margin-top:2px}.knowledge-layer p{font-size:12px;line-height:1.95;color:var(--ink2)}.public-graph{margin-top:48px}.public-graph .panel-heading a{font-size:12px;white-space:nowrap;color:var(--ink)}.graph-description{font-size:13px;line-height:1.9;color:var(--ink2);max-width:820px;margin:14px 0 22px}.knowledge-links{display:flex;flex-wrap:wrap;justify-content:space-between;gap:15px;padding:20px 0;border-bottom:1px solid var(--ks-line);font-size:12px}.knowledge-links a{color:var(--ink2)}
  :global(html[data-theme=klein]) .knowledge-system{--ks-fill:rgba(10,10,15,.76);--ks-accent:#c0c8e9;--ks-line:rgba(255,255,255,.22)}:global(html[data-theme=klein]) .ontology-node{background:#181922}:global(html[data-theme=klein]) .ontology-node[aria-pressed=true]{background:#343647}:global(html[data-theme=hud]) .knowledge-system{--ks-fill:rgba(249,251,247,.9);--ks-accent:#466c73;--ks-line:rgba(43,75,79,.2);--ks-soft:rgba(66,103,109,.055);--ks-muted:#5d7275}:global(html[data-theme=hud]) .ontology-node{background:#f2f6f2}:global(html[data-theme=hud]) .ontology-node[aria-pressed=true]{background:#dce8e5}
  @media(max-width:1000px){.ontology-layout{grid-template-columns:1.3fr 1fr;gap:15px}.ontology-node{width:108px}.ontology-details{padding-left:20px}.knowledge-stats>div{padding:24px 20px}.loop-flow{gap:15px}.loop-flow li:not(:last-child)::after{right:-12px}.loop-flow h4{font-size:16px}.tool-roles{gap:12px}.knowledge-layers{gap:13px}.knowledge-layer{padding:20px}}
  @media(max-width:760px){.knowledge-system{padding:80px 0}.knowledge-system .chapter-head{margin-bottom:26px}.knowledge-system .ch-no{font-size:9px;letter-spacing:.12em}.knowledge-system .chapter-head h2{font-size:30px;line-height:1.6}.knowledge-system .ch-sub{font-size:13px}.knowledge-stats{grid-template-columns:1fr 1fr}.knowledge-stats>div{padding:22px 18px}.knowledge-stats>div:nth-child(2){border-right:0}.knowledge-stats>div:nth-child(-n+2){border-bottom:1px solid var(--ks-line)}.knowledge-stats strong{font-size:29px}.knowledge-stats span{font-size:10px}.snapshot-scope{font-size:9px;margin-bottom:25px}.snapshot-scope summary span{margin-left:6px}.snapshot-scope p{font-size:11px}.ontology-panel,.loop-panel{padding:22px 18px}.panel-heading{display:block}.panel-heading h3,.layer-heading h3{font-size:22px}.panel-note{display:block;margin-top:7px;font-size:9px}.ontology-layout{grid-template-columns:1fr;gap:10px;margin-top:10px}.ontology-map{height:310px}.ontology-node{width:101px;padding:10px 3px}.ontology-node[data-node=source],.ontology-node[data-node=work]{left:23%}.ontology-node[data-node=concept],.ontology-node[data-node=project]{left:77%}.ontology-node[data-node=method]{left:82%}.ontology-node[data-node=feedback]{left:18%}.ontology-node>span{font-size:12px}.ontology-node small{font-size:7px}.ontology-center{width:88px;height:88px}.ontology-center strong{font-size:19px}.ontology-center>span{font-size:6px}.ontology-center small{font-size:8px}.edge-label{font-size:7px}.ontology-details{border-left:0;border-top:1px solid var(--ks-line);padding:20px 0 5px;min-height:0}.ontology-details h4{font-size:19px}.ontology-details p{font-size:12px}.ontology-caption{font-size:9px}.tool-roles{display:grid;gap:10px;margin:18px 0 24px}.tool-roles b{display:inline-block;width:86px}.loop-flow{grid-template-columns:1fr;gap:0}.loop-flow li{padding:16px 0 20px 36px;border-top:0;border-left:1px solid var(--ks-line);margin-left:8px}.step-number{position:absolute;left:-8px;top:19px;background:var(--space-1);font-size:9px;padding:2px}.loop-flow h4{font-size:18px;margin:0 0 6px}.loop-flow p{font-size:12px;margin-top:7px}.loop-flow li:not(:last-child)::after{content:'↓';right:auto;left:-4px;top:auto;bottom:0;font-size:11px}.loop-return{font-size:9px;margin-top:0;padding:8px 10px}.loop-return span{font-size:18px}.loop-status{grid-template-columns:1fr;gap:12px;margin-top:20px}.loop-boundary{font-size:9px}.knowledge-layers{grid-template-columns:1fr 1fr;gap:12px}.knowledge-layer{padding:18px 14px}.layer-name{gap:8px}.layer-name h4{font-size:16px}.layer-name>span{font-size:8px}.layer-count{font-size:19px}.layer-count small{font-size:8px}.knowledge-layer p{font-size:11px}.layer-heading{margin-top:35px}.layer-heading p{font-size:12px}.public-graph .panel-heading a{display:inline-block;margin-top:12px}.graph-description{font-size:12px}.knowledge-links{font-size:11px}.micro{font-size:8px}}
  @media(prefers-reduced-motion:reduce){.ontology-node{transition:none}}
</style>
