<canvas id="water-ripple" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#water-ripple');

  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true });
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ripples: Ripple[] = [];
    const wakes: Wake[] = [];

    type Ripple = {
      x: number;
      y: number;
      born: number;
      life: number;
      radius: number;
      strength: number;
      phase: number;
      squash: number;
    };

    type Wake = {
      x1: number;
      y1: number;
      x2: number;
      y2: number;
      born: number;
      life: number;
      strength: number;
    };

    let width = 0;
    let height = 0;
    let dpr = 1;
    let frame = 0;
    let running = false;
    let pointerInside = false;
    let lastPoint = { x: innerWidth * 0.72, y: innerHeight * 0.3, t: 0 };

    const active = () => document.documentElement.dataset.theme === 'hud';
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    function resize() {
      if (!ctx) return;
      dpr = Math.min(devicePixelRatio || 1, 1.5);
      width = innerWidth;
      height = innerHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (reduced && active()) drawReduced();
    }

    function addRipple(x: number, y: number, strength = 1, radius = 180) {
      const now = performance.now();
      ripples.push({
        x,
        y,
        born: now,
        life: 2100 + strength * 520,
        radius,
        strength,
        phase: Math.random() * Math.PI * 2,
        squash: 0.56 + Math.random() * 0.1,
      });
      if (ripples.length > 26) ripples.splice(0, ripples.length - 26);
      ensureLoop();
    }

    function addWake(x1: number, y1: number, x2: number, y2: number, strength: number) {
      wakes.push({ x1, y1, x2, y2, born: performance.now(), life: 760, strength });
      if (wakes.length > 18) wakes.shift();
      ensureLoop();
    }

    function drawRipple(ripple: Ripple, now: number) {
      if (!ctx) return false;
      const progress = (now - ripple.born) / ripple.life;
      if (progress >= 1) return false;

      const spread = easeOut(progress);
      const radius = 8 + ripple.radius * spread;
      const fade = Math.pow(1 - progress, 1.7) * ripple.strength;

      ctx.save();
      ctx.translate(ripple.x, ripple.y);
      ctx.scale(1, ripple.squash);
      ctx.globalCompositeOperation = 'multiply';

      const basin = ctx.createRadialGradient(0, 0, Math.max(0, radius * 0.18), 0, 0, radius);
      basin.addColorStop(0, `rgba(46, 73, 79, ${0.018 * fade})`);
      basin.addColorStop(0.62, `rgba(45, 72, 77, ${0.012 * fade})`);
      basin.addColorStop(1, 'rgba(45, 72, 77, 0)');
      ctx.fillStyle = basin;
      ctx.beginPath();
      ctx.arc(0, 0, radius, 0, Math.PI * 2);
      ctx.fill();

      for (let band = 0; band < 4; band++) {
        const offset = band * (8 + spread * 6);
        const bandRadius = Math.max(1, radius - offset);
        const wobble = Math.sin(progress * 12 + ripple.phase + band * 1.7) * 2.2;
        ctx.beginPath();
        ctx.arc(0, 0, bandRadius + wobble, 0.1 + band * 0.08, Math.PI * 2 - 0.16);
        ctx.strokeStyle = `rgba(22, 48, 54, ${fade * (0.16 - band * 0.025)})`;
        ctx.lineWidth = Math.max(0.55, (2.2 - band * 0.32) * (1 - progress * 0.7));
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(0, -1.3, bandRadius + 1.8 + wobble, Math.PI * 1.05, Math.PI * 1.88);
        ctx.strokeStyle = `rgba(255, 255, 252, ${fade * (0.22 - band * 0.03)})`;
        ctx.lineWidth = 0.85;
        ctx.stroke();
      }
      ctx.restore();
      return true;
    }

    function drawWake(wake: Wake, now: number) {
      if (!ctx) return false;
      const progress = (now - wake.born) / wake.life;
      if (progress >= 1) return false;
      const fade = Math.pow(1 - progress, 2) * wake.strength;
      const dx = wake.x2 - wake.x1;
      const dy = wake.y2 - wake.y1;
      const len = Math.hypot(dx, dy) || 1;
      const nx = -dy / len;
      const ny = dx / len;
      const opening = 3 + progress * 22;

      ctx.save();
      ctx.globalCompositeOperation = 'multiply';
      ctx.lineCap = 'round';
      for (const side of [-1, 1]) {
        ctx.beginPath();
        ctx.moveTo(wake.x1 + nx * opening * side, wake.y1 + ny * opening * side);
        ctx.quadraticCurveTo(
          (wake.x1 + wake.x2) / 2 + nx * opening * 1.8 * side,
          (wake.y1 + wake.y2) / 2 + ny * opening * 1.8 * side,
          wake.x2 + nx * opening * 0.35 * side,
          wake.y2 + ny * opening * 0.35 * side,
        );
        ctx.strokeStyle = `rgba(25, 53, 59, ${fade * 0.15})`;
        ctx.lineWidth = 1.25;
        ctx.stroke();
      }
      ctx.restore();
      return true;
    }

    function drawCursorSurface(now: number) {
      if (!ctx || !pointerInside) return;
      const pulse = 0.5 + Math.sin(now * 0.004) * 0.5;
      const glow = ctx.createRadialGradient(lastPoint.x, lastPoint.y, 0, lastPoint.x, lastPoint.y, 48 + pulse * 8);
      glow.addColorStop(0, 'rgba(255,255,252,.22)');
      glow.addColorStop(0.38, 'rgba(42,70,76,.035)');
      glow.addColorStop(1, 'rgba(42,70,76,0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(lastPoint.x, lastPoint.y, 58, 0, Math.PI * 2);
      ctx.fill();
    }

    function render(now: number) {
      if (!ctx || !active() || document.hidden) {
        running = false;
        return;
      }

      ctx.clearRect(0, 0, width, height);
      drawCursorSurface(now);

      for (let i = wakes.length - 1; i >= 0; i--) {
        if (!drawWake(wakes[i], now)) wakes.splice(i, 1);
      }
      for (let i = ripples.length - 1; i >= 0; i--) {
        if (!drawRipple(ripples[i], now)) ripples.splice(i, 1);
      }

      if (ripples.length || wakes.length || pointerInside) frame = requestAnimationFrame(render);
      else running = false;
    }

    function ensureLoop() {
      if (reduced || running || !active() || document.hidden) return;
      running = true;
      frame = requestAnimationFrame(render);
    }

    function drawReduced() {
      if (!ctx || !active()) return;
      ctx.clearRect(0, 0, width, height);
      const x = width * 0.76;
      const y = height * 0.28;
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(1, 0.62);
      for (let i = 0; i < 4; i++) {
        ctx.beginPath();
        ctx.arc(0, 0, 48 + i * 23, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(26, 53, 59, ${0.12 - i * 0.02})`;
        ctx.lineWidth = 1;
        ctx.stroke();
      }
      ctx.restore();
    }

    function syncTheme() {
      cancelAnimationFrame(frame);
      running = false;
      pointerInside = false;
      ripples.length = 0;
      wakes.length = 0;
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      if (!active()) return;
      if (reduced) drawReduced();
      else {
        addRipple(width * 0.76, height * 0.3, 0.75, Math.min(width, height) * 0.22);
        addRipple(width * 0.83, height * 0.33, 0.42, Math.min(width, height) * 0.14);
      }
    }

    addEventListener('pointermove', (event) => {
      if (!active() || reduced) return;
      const now = performance.now();
      const point = { x: event.clientX, y: event.clientY, t: now };
      const distance = Math.hypot(point.x - lastPoint.x, point.y - lastPoint.y);
      const elapsed = Math.max(12, now - lastPoint.t);
      const speed = Math.min(2.2, distance / elapsed);
      pointerInside = true;

      if (distance > 12 && now - lastPoint.t > 42) {
        addWake(lastPoint.x, lastPoint.y, point.x, point.y, 0.5 + speed * 0.45);
        addRipple(
          (lastPoint.x + point.x) / 2,
          (lastPoint.y + point.y) / 2,
          0.38 + speed * 0.34,
          92 + speed * 82,
        );
        lastPoint = point;
      } else {
        lastPoint.x = point.x;
        lastPoint.y = point.y;
      }
      ensureLoop();
    }, { passive: true });

    addEventListener('pointerdown', (event) => {
      if (!active() || reduced) return;
      lastPoint = { x: event.clientX, y: event.clientY, t: performance.now() };
      pointerInside = true;
      addRipple(event.clientX, event.clientY, 1.25, 250);
      setTimeout(() => addRipple(event.clientX, event.clientY, 0.72, 175), 110);
    }, { passive: true });

    addEventListener('pointerleave', () => {
      pointerInside = false;
    }, { passive: true });

    addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(frame);
        running = false;
      } else if (active()) {
        ensureLoop();
      }
    });

    new MutationObserver(syncTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    resize();
    syncTheme();
  }
</script>
