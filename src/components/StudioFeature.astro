---
import AtlasPreview from './AtlasPreview.astro';
---
<section class="studio-feature" id="digital-studio" aria-labelledby="studio-feature-title">
  <div class="feature-copy">
    <p class="label">WORLD ATLAS / 三维地图作品</p>
    <h2 id="studio-feature-title">从地球，<br />走进一座城。</h2>
    <p class="description">把地理数据、城市建筑与交互连在一起。<br />旋转、靠近，在三维空间里探索真实地点。</p>
    <div class="tech"><span>地理数据</span><i>→</i><span>3D 建模</span><i>→</i><span>实时交互</span></div>
    <a class="atlas-link" href="https://mingteck.com/atlas" target="_blank" rel="noopener">进入完整地图 <span>↗</span></a>
    <a class="studio-link" href="/studio/">更多作品：Bloom · 沿途 <span>→</span></a>
  </div>
  <AtlasPreview />
</section>
<style>
  .studio-feature{position:relative;z-index:1;scroll-margin-top:84px;max-width:1120px;margin:0 auto 85px;display:grid;grid-template-columns:.72fr 1.28fr;background:#101f2b;color:#e3edf1;border:1px solid #6e9aa14a;overflow:hidden;border-radius:6px;text-align:left;box-shadow:0 24px 65px #0003}.feature-copy{padding:36px 0 36px 35px;align-self:center;position:relative;z-index:1}.label{font:10px/1.8 'JetBrains Mono',monospace;letter-spacing:.06em;color:#8ec8d2;margin:0 0 24px}.feature-copy h2{font-family:'Noto Serif SC',serif;font-size:35px;font-weight:700;line-height:1.65;letter-spacing:0;margin:0;background:none;color:#edf2ed;-webkit-text-fill-color:initial}.description{font:12px/2.1 'PingFang SC',system-ui,sans-serif;color:#a6bdc8;margin:22px 0}.tech{display:flex;gap:9px;align-items:center;font:10px/1.8 system-ui;color:#b4ccd5}.tech i{color:#648b9b;font-style:normal}.atlas-link{display:inline-flex;gap:32px;font:12px/1.8 system-ui;color:#efe0b8;border-bottom:1px solid #b9a377;padding-bottom:8px;text-decoration:none;margin-top:32px}.studio-link{display:flex;align-items:center;gap:22px;width:max-content;max-width:100%;font:10px/1.8 system-ui;color:#91acbb;text-decoration:none;margin-top:24px}.studio-link:hover{color:#e3edf1}a:focus-visible{outline:2px solid #9ddbe7;outline-offset:5px}
  @media(max-width:1160px){.studio-feature{margin-left:28px;margin-right:28px}.feature-copy{padding-left:28px}.feature-copy h2{font-size:31px}}
  @media(max-width:760px){.studio-feature{grid-template-columns:1fr;margin:0 18px 55px}.feature-copy{padding:27px 24px 16px}.feature-copy h2{font-size:28px;line-height:1.65}.feature-copy h2 br{display:none}.label{font-size:9px;margin-bottom:14px}.description{font-size:12px;margin:15px 0 12px}.description br{display:none}.tech{font-size:9px}.atlas-link{margin-top:20px;font-size:11px}.studio-link{display:inline-flex;margin:0 0 0 17px;font-size:9px;gap:5px}}
  @media(max-width:380px){.studio-link{display:flex;margin:15px 0 0}}
</style>

<style>
:global(html[data-theme='constellation']) .studio-feature{background:linear-gradient(135deg,#1b1426,#100d18);border-color:#755a8355;color:#eee7f0;border-radius:9px;box-shadow:0 20px 60px #0002}
:global(html[data-theme='constellation']) .feature-copy h2{color:#eee7f0;font-size:36px;font-weight:700}
:global(html[data-theme='constellation']) .label{color:#c5a876;font-size:8px;letter-spacing:.14em}
:global(html[data-theme='constellation']) .description{color:#b6a3c2}
:global(html[data-theme='constellation']) .tech{color:#aa95b9}
:global(html[data-theme='constellation']) .tech i{color:#806b90}
:global(html[data-theme='constellation']) .atlas-link{color:#d6bd8d;border-color:#92754c66}
:global(html[data-theme='constellation']) .studio-link{color:#aa95b9}
:global(html[data-theme='constellation']) .studio-link:hover{color:#e6c995}
:global(html[data-theme='constellation']) .studio-feature :global(.atlas-preview){color:#e3d7ec;background:radial-gradient(ellipse at 52% 50%,#44314d66,transparent 70%)}
:global(html[data-theme='constellation']) .studio-feature :global(.atlas-toolbar button){background:#191221bd;border-color:#84609155;color:#b9a4c8}
:global(html[data-theme='constellation']) .studio-feature :global(.atlas-toolbar button[aria-pressed='true']){background:#d6b77b;border-color:#d6b77b;color:#18111e}
:global(html[data-theme='constellation']) .studio-feature :global(.live){color:#b5a0c3}
:global(html[data-theme='constellation']) .studio-feature :global(.live::before){background:#8cc6b3}
:global(html[data-theme='constellation']) .studio-feature :global(.atlas-loading){background:#18102266;color:#d5c1e0}
:global(html[data-theme='constellation']) .studio-feature :global(.atlas-controls){border-color:#84609144}
:global(html[data-theme='constellation']) .studio-feature :global(.atlas-controls p){color:#ac96ba}
:global(html[data-theme='constellation']) .studio-feature :global(.atlas-controls button){color:#d5c1e0;border-color:#84609155}
:global(html[data-theme='constellation']) .studio-feature :global(.atlas-controls button[aria-pressed='true']){color:#e6c995;border-color:#b99b6b}
:global(html[data-theme='constellation']) .studio-feature :global(.place-coordinate){color:#a68bb7}
:global(html[data-theme='constellation']) .studio-feature :global(.attribution){color:#8d779d}
@media(max-width:760px){:global(html[data-theme='constellation']) .feature-copy h2{font-size:27px}}
</style>
