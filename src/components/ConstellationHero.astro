<script is:inline>
(function(){
  function setup(){
    var host=document.querySelector('[data-home-constellation]');if(!host)return;
    var button=host.querySelector('[data-star-motion]'),status=host.querySelector('[data-star-status]');
    var reduced=matchMedia('(prefers-reduced-motion: reduce)'),motion=!reduced.matches,cleanup=null;
    function label(){button.textContent=motion&&!reduced.matches?'星核运行中':'星核静态';button.setAttribute('aria-pressed',String(motion&&!reduced.matches));status.textContent=reduced.matches?'遵循系统减少动态设置':'';}
    function sync(){if(cleanup){cleanup();cleanup=null;}if(document.documentElement.dataset.theme==='constellation'&&window.OwnerCosmos)cleanup=window.OwnerCosmos.mount(host,{motion:motion&&!reduced.matches});label();}
    button.addEventListener('click',function(){motion=reduced.matches?false:!motion;window.OwnerCosmos&&window.OwnerCosmos.setMotion(motion);label();});
    reduced.addEventListener('change',function(){if(reduced.matches)motion=false;window.OwnerCosmos&&window.OwnerCosmos.setMotion(motion);label();});
    new MutationObserver(sync).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
    window.addEventListener('pagehide',function(){cleanup&&cleanup();});sync();
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',setup,{once:true});else setup();
})();
</script>
