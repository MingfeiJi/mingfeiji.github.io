---
import 'lxgw-wenkai-webfont/lxgwwenkai-regular.css';
import 'lxgw-wenkai-webfont/lxgwwenkai-bold.css';
import '@fontsource/noto-serif-sc/700.css';
import '@fontsource/noto-serif-sc/900.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import Cosmos from '../components/Cosmos.astro';
import WaterRipple from '../components/WaterRipple.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = '纪鸣飞 · 星辰大海 — AI 产品架构师 / 企业 AI 化转型专家',
  description = '4 年+ AI 产品经验，AI Native 产品架构师。从制造业数字化转型到千人电商硅基员工计划，再到大厂出海内容增长 AI 中台——FDE 式全栈交付，用可运行的产物代替纯 PRD 推动落地。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content="纪鸣飞 · Mingfei Ji" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={new URL('/og-cover.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="纪鸣飞 · AI 产品架构师 / FDE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-cover.png', Astro.site)} />
    <meta name="theme-color" content="#030412" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✦</text></svg>" />
    <script is:inline>
      // 防闪烁：渲染前应用已保存主题
      (function () {
        var t = localStorage.getItem('mfj-theme') || 'cosmos';
        if (t === 'paper' || t === 'snow' || t === 'cyber') {
          t = 'hud';
          localStorage.setItem('mfj-theme', t);
        }
        if (t !== 'cosmos' && t !== 'hud' && t !== 'klein') t = 'cosmos';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <div id="voyage-progress"></div>
    <Cosmos />
    <WaterRipple />

    <nav class="nav">
      <div class="nav-inner">
        <a href="#top" class="nav-logo">纪鸣飞<span> ✦</span></a>
        <div class="nav-links">
          <a href="/#voyage">航程</a>
          <a href="/#flagship">旗舰</a>
          <a href="/#works">星图集</a>
          <a href="/#logbook">航行日志</a>
          <a href="/#method">方法论</a>
          <a href="/#knowledge">知识星系</a>
          <a href="/#geek">极客雷达</a>
          <a href="/prototypes/">原型</a>
          <a href="/graph/">图谱</a>
          <a href="/library/">藏书阁</a>
          <a href="/articles/">信号塔</a>
          <a href="/#contact">泊港</a>
        </div>
      </div>
    </nav>

    <main class="universe">
      <slot />
    </main>

    <footer class="footer universe" id="contact">
      <div class="wrap footer-inner">
        <div>
          <div class="f-name">纪鸣飞 <span style="color:var(--star)">/</span> Mingfei Ji</div>
          <div class="f-meta">
            AI PRODUCT ARCHITECT · FORWARD DEPLOYED ENGINEER<br />
            上海 · github.com/MingfeiJi
          </div>
        </div>
        <div class="f-links">
          <a href="https://mingfeiji.github.io/tripflow-ops-playbook/" target="_blank" rel="noopener">中台运营手册 ↗</a>
          <a href="https://mingfeiji.github.io/tripflow-38-intents/" target="_blank" rel="noopener">38 意图全景图 ↗</a>
          <a href="https://mingfeiji.github.io/tripflow-experience-map/" target="_blank" rel="noopener">用户体验地图 ↗</a>
        </div>
        <div class="f-meta" style="text-align:right">
          「人人都是产品经理」专栏作者<br />
          飞书开发者大会受邀嘉宾<br />
          Building in public · 2026 ✦
        </div>
      </div>
    </footer>

    <button class="theme-fab" id="theme-fab" title="切换主题" aria-label="切换主题">🎨</button>
    <div class="theme-panel" id="theme-panel">
      <div class="tp-title">THEME · 三种视觉语言</div>
      <button class="theme-opt" data-t="cosmos"><span class="sw"><i style="background:#030412"></i><i style="background:#7dd3fc"></i><i style="background:#a78bfa"></i></span>🌌 星辰大海</button>
      <button class="theme-opt" data-t="hud"><span class="sw"><i style="background:#F4F7F4"></i><i style="background:#1f3539"></i><i style="background:#9E2B25"></i></span>〰 水波墨境</button>
      <button class="theme-opt" data-t="klein"><span class="sw"><i style="background:#000"></i><i style="background:#fff"></i><i style="background:#8a8a8a"></i></span>⚫️ 曜黑玻璃</button>
    </div>

    <script>
      // 主题切换器
      const fab = document.getElementById('theme-fab')!;
      const panel = document.getElementById('theme-panel')!;
      const themeOpts = panel.querySelectorAll<HTMLButtonElement>('.theme-opt');
      function markActive() {
        const cur = document.documentElement.getAttribute('data-theme') || 'cosmos';
        themeOpts.forEach((o) => o.classList.toggle('active', o.dataset.t === cur));
      }
      markActive();
      fab.addEventListener('click', (e) => { e.stopPropagation(); panel.classList.toggle('open'); });
      document.addEventListener('click', (e) => {
        if (!panel.contains(e.target as Node)) panel.classList.remove('open');
      });
      themeOpts.forEach((o) =>
        o.addEventListener('click', () => {
          const t = o.dataset.t!;
          document.documentElement.setAttribute('data-theme', t);
          localStorage.setItem('mfj-theme', t);
          markActive();
        })
      );

      // 滚动入场
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('in')),
        { threshold: 0.08 }
      );
      document.querySelectorAll('.reveal, .reveal-l, [data-stagger]').forEach((el) => io.observe(el));

      // 航程进度条
      const bar = document.getElementById('voyage-progress');
      addEventListener('scroll', () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        if (bar && max > 0) bar.style.width = `${(scrollY / max) * 100}%`;
      }, { passive: true });

      // 卡片鼠标光晕 + 3D 倾斜
      document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const r = card.getBoundingClientRect();
          const x = e.clientX - r.left, y = e.clientY - r.top;
          card.style.setProperty('--mx', `${x}px`);
          card.style.setProperty('--my', `${y}px`);
          const rx = ((y / r.height) - 0.5) * -5;
          const ry = ((x / r.width) - 0.5) * 5;
          card.style.transform = `translateY(-6px) rotateX(${rx}deg) rotateY(${ry}deg)`;
        });
        card.addEventListener('mouseleave', () => { card.style.transform = ''; });
      });

      // 仪表盘数字滚动
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const cio = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          cio.unobserve(el);
          const target = parseFloat(el.dataset.count || '0');
          const dur = 1400;
          const t0 = performance.now();
          const fmt = (v: number) => (Number.isInteger(target) ? Math.round(v).toString() : v.toFixed(1));
          const step = (now: number) => {
            const p = Math.min((now - t0) / dur, 1);
            el.textContent = fmt(target * (1 - Math.pow(1 - p, 3)));
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        });
      }, { threshold: 0.4 });
      counters.forEach((el) => cio.observe(el));
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
