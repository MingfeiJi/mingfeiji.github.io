---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const sorted = articles.sort(
    (a, b) => (b.data.created?.getTime() ?? 0) - (a.data.created?.getTime() ?? 0)
  );
  return sorted.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: sorted[i + 1] ?? null, next: sorted[i - 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={`${d.title} — 纪鸣飞`} description={d.title}>
  <article class="chapter" style="padding-top:150px">
    <div class="wrap article-wrap">
      <header class="article-head">
        <div class="kicker">SIGNAL · TRANSMISSION</div>
        <h1>{d.title}</h1>
        <div class="article-meta">
          {d.created && <span>{d.created.toISOString().slice(0, 10)}</span>}
          {d.word_count && <span>{(d.word_count / 1000).toFixed(1)}k 字</span>}
          <span>纪鸣飞</span>
        </div>
        <div class="t-chips" style="margin-top:18px">
          {d.tags.slice(0, 6).map((t: string) => <span class="chip">{t}</span>)}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="article-nav">
        {prev ? <a href={`/articles/${prev.id}/`}>← {prev.data.title}</a> : <span />}
        {next ? <a href={`/articles/${next.id}/`} style="text-align:right">{next.data.title} →</a> : <span />}
      </nav>

      <div style="margin-top:48px;display:flex;gap:14px;justify-content:center">
        <a class="btn" href="/articles/">全部文章</a>
        <a class="btn" href="/">返回主站</a>
      </div>
    </div>
  </article>
</Base>

<style>
  .article-wrap { max-width: 760px; }
  .article-head { margin-bottom: 48px; padding-bottom: 36px; border-bottom: 1px solid var(--line); }
  .article-head h1 {
    font-size: clamp(26px, 4.6vw, 40px); line-height: 1.4; margin: 16px 0 18px;
    background: linear-gradient(120deg, #fff 30%, var(--star) 90%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .article-meta { display: flex; gap: 18px; font-family: var(--mono); font-size: 12.5px; color: var(--ink3); }
  .article-nav {
    margin-top: 72px; padding-top: 28px; border-top: 1px solid var(--line);
    display: flex; justify-content: space-between; gap: 24px; font-size: 14px;
  }
  .article-nav a { max-width: 46%; }
</style>

<style is:global>
  .prose {
    font-family: var(--body-font, var(--sans));
    font-size: 16.5px;
    line-height: 2.05;
    color: var(--ink);
  }
  .prose h1 { display: none; } /* 正文首个 H1 与页头重复，隐藏 */
  .prose h2 {
    font-family: var(--serif); font-size: 25px; color: #fff;
    margin: 56px 0 20px; padding-left: 16px;
    border-left: 3px solid var(--star);
  }
  .prose h3 { font-family: var(--serif); font-size: 19.5px; color: #fff; margin: 38px 0 14px; }
  .prose h4 { font-family: var(--serif); font-size: 17px; color: var(--star); margin: 28px 0 10px; }
  .prose p { margin: 0 0 22px; }
  .prose strong { color: #fff; }
  .prose a { color: var(--star); border-bottom: 1px dashed rgba(125,211,252,.4); }
  .prose ul, .prose ol { margin: 0 0 22px; padding-left: 26px; }
  .prose li { margin-bottom: 10px; }
  .prose li::marker { color: var(--star); }
  .prose blockquote {
    margin: 28px 0; padding: 18px 26px;
    background: rgba(125, 211, 252, .05);
    border-left: 3px solid var(--nebula);
    border-radius: 0 10px 10px 0;
    color: var(--ink2);
  }
  .prose blockquote p:last-child { margin-bottom: 0; }
  .prose code {
    font-family: var(--mono); font-size: 14px;
    background: rgba(125, 211, 252, .1); color: var(--star);
    padding: 2px 7px; border-radius: 5px;
  }
  .prose pre {
    margin: 0 0 24px; padding: 20px 24px; border-radius: 12px;
    border: 1px solid var(--line);
    background: rgba(3, 4, 18, .8) !important;
    overflow-x: auto; font-size: 13.5px; line-height: 1.7;
  }
  .prose pre code { background: none; color: inherit; padding: 0; }
  .prose hr { border: none; border-top: 1px solid var(--line); margin: 44px auto; width: 40%; }
  .prose table {
    width: 100%; border-collapse: collapse; margin: 0 0 26px; font-size: 14px;
    display: block; overflow-x: auto;
  }
  .prose th, .prose td { padding: 10px 14px; border: 1px solid var(--line); text-align: left; }
  .prose th { background: rgba(125, 211, 252, .07); color: #fff; font-family: var(--serif); white-space: nowrap; }
  .prose img { max-width: 100%; border-radius: 10px; }
</style>
