---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const sorted = articles.sort(
    (a, b) => (b.data.created?.getTime() ?? 0) - (a.data.created?.getTime() ?? 0)
  );
  return sorted.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: sorted[i + 1] ?? null, next: sorted[i - 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={`${d.title} — 纪鸣飞`} description={d.title}>
  <article class="chapter" style="padding-top:150px">
    <div class="wrap article-wrap">
      <header class="article-head">
        <div class="kicker">SIGNAL · TRANSMISSION</div>
        <h1>{d.title}</h1>
        <div class="article-meta">
          {d.created && <span>{d.created.toISOString().slice(0, 10)}</span>}
          {d.word_count && <span>{(d.word_count / 1000).toFixed(1)}k 字</span>}
          <span>纪鸣飞</span>
        </div>
        <div class="t-chips" style="margin-top:18px">
          {d.tags.slice(0, 6).map((t: string) => <span class="chip">{t}</span>)}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="article-nav">
        {prev ? <a href={`/articles/${prev.id}/`}>← {prev.data.title}</a> : <span />}
        {next ? <a href={`/articles/${next.id}/`} style="text-align:right">{next.data.title} →</a> : <span />}
      </nav>

      <div style="margin-top:48px;display:flex;gap:14px;justify-content:center">
        <a class="btn" href="/articles/">全部文章</a>
        <a class="btn" href="/">返回主站</a>
      </div>
    </div>
  </article>
</Base>

<style>
  .article-wrap { max-width: 760px; }
  .article-head { margin-bottom: 48px; padding-bottom: 36px; border-bottom: 1px solid var(--line); }
  .article-head h1 {
    font-size: clamp(26px, 4.6vw, 40px); line-height: 1.4; margin: 16px 0 18px;
    background: linear-gradient(120deg, #fff 30%, var(--star) 90%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .article-meta { display: flex; gap: 18px; font-family: var(--mono); font-size: 12.5px; color: var(--ink3); }
  .article-nav {
    margin-top: 72px; padding-top: 28px; border-top: 1px solid var(--line);
    display: flex; justify-content: space-between; gap: 24px; font-size: 14px;
  }
  .article-nav a { max-width: 46%; }
</style>


