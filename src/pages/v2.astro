          return ['在的～', '想了解鸣飞的项目、能力，还是怎么联系？下面几个按钮可以直接点。'];
        return ['这个我这版演示人格还答不全🙈', '接上真·AI 模式后我能聊得更细。', '急的话直接邮箱找鸣飞：1966315939@qq.com'];
      }

      // Astro scoped 样式靠 data-astro-cid-* 属性匹配；JS 动态创建的节点必须补上，否则拿不到任何样式
      var cidAttr = '';
      for (var ai = 0; ai < root.attributes.length; ai++)
        if (root.attributes[ai].name.indexOf('data-astro-cid-') === 0) { cidAttr = root.attributes[ai].name; break; }
      function el(cls, text) {
        var d = document.createElement('div'); d.className = cls; d.textContent = text;
        if (cidAttr) d.setAttribute(cidAttr, '');
        return d;
      }
      function scrollDown() { log.scrollTop = log.scrollHeight; }
      function addBubble(role, text) { var b = el('pet-msg ' + (role === 'me' ? 'me' : 'bot'), text); log.appendChild(b); scrollDown(); return b; }
      function typing() {
        var w = el('pet-typing', '');
        w.innerHTML = '<span></span><span></span><span></span>';
        if (cidAttr) for (var si = 0; si < w.children.length; si++) w.children[si].setAttribute(cidAttr, '');
        log.appendChild(w); scrollDown(); return w;
      }

      // 串行队列：任何时候只播一段，避免问候与回答交叠
      var queue = [], playing = false;
      function botSay(lines, done) { queue.push({ lines: lines, done: done }); pump(); }
      function pump() {
        if (playing) return;
        var job = queue.shift(); if (!job) return;
        playing = true; var i = 0;
        (function next() {
          if (i >= job.lines.length) { playing = false; if (job.done) job.done(); pump(); return; }
          var t = typing();
          setTimeout(function () {
            t.remove(); addBubble('bot', job.lines[i]); i++;
            setTimeout(next, 260);
          }, 380 + Math.min(job.lines[i].length * 14, 700));
        })();
      }

      function send(q) {
        if (busy || !q) return;
        busy = true; input.value = '';
        addBubble('me', q);
        history.push({ role: 'user', content: q });
        if (!endpoint) {
          var lines = demoReply(q);
          botSay(lines, function () { history.push({ role: 'assistant', content: lines.join(' ') }); busy = false; });
          return;
        }
        // 真·AI：非流式（后端返回 {reply}），按短句拆成多气泡，更像真人
        var t = typing();
        fetch(endpoint, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history.slice(-12) }),
        }).then(function (resp) {
          return resp.json().catch(function () { return {}; });
        }).then(function (d) {
          t.remove();
          var reply = (d && d.reply) ? String(d.reply) : '（我走神了一下，再说一次？）';
          var parts = reply.split(/\n+/).filter(Boolean);
          botSay(parts.length ? parts : [reply], function () { history.push({ role: 'assistant', content: reply }); busy = false; });
        }).catch(function () {
          t.remove(); addBubble('bot', '网络有点闹脾气，稍后再试～'); busy = false;
        });
      }

      function placePanel() {
        var r = root.getBoundingClientRect();
        panel.classList.toggle('below', r.top < innerHeight / 2);
        panel.classList.toggle('right', r.left > innerWidth / 2);
      }
      function open(skipGreet) {
        if (!opened) {
          opened = true;
          placePanel();
          panel.hidden = false; fab.setAttribute('aria-expanded', 'true'); hi.classList.remove('show');
          if (!skipGreet && log.childElementCount === 0)
            botSay(['嗨，我是鸣飞的 AI 数字分身「小飞」👋', '想了解他的项目、能力，还是怎么联系？']);
          setTimeout(function () { input.focus(); }, 60);
        }
      }
      function close() { opened = false; panel.hidden = true; fab.setAttribute('aria-expanded', 'false'); }

      // ── 拖拽换位置（记忆到 localStorage）──
      var POSKEY = 'mfj-pet-pos';
      function applyPos(x, y) {
        var w = root.offsetWidth || 64, h = root.offsetHeight || 64;
        x = Math.max(8, Math.min(innerWidth - w - 8, x));
        y = Math.max(8, Math.min(innerHeight - h - 8, y));
        root.style.left = x + 'px'; root.style.top = y + 'px';
        root.style.right = 'auto'; root.style.bottom = 'auto';
      }
      try { var sp = JSON.parse(localStorage.getItem(POSKEY) || 'null'); if (sp) applyPos(sp.x, sp.y); } catch (e) {}
      addEventListener('resize', function () { var r = root.getBoundingClientRect(); if (root.style.left) applyPos(r.left, r.top); });

      var dragging = false, moved = false, sx = 0, sy = 0, ox = 0, oy = 0;
      fab.addEventListener('pointerdown', function (e) {
        dragging = true; moved = false; sx = e.clientX; sy = e.clientY;
        var r = root.getBoundingClientRect(); ox = r.left; oy = r.top;
        try { fab.setPointerCapture(e.pointerId); } catch (er) {}
      });
      fab.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        var dx = e.clientX - sx, dy = e.clientY - sy;
        if (!moved && Math.abs(dx) + Math.abs(dy) > 5) { moved = true; fab.classList.add('grabbing'); if (opened) close(); hi.classList.remove('show'); }
        if (moved) applyPos(ox + dx, oy + dy);
      });
      fab.addEventListener('pointerup', function (e) {
        if (!dragging) return; dragging = false; fab.classList.remove('grabbing');
        try { fab.releasePointerCapture(e.pointerId); } catch (er) {}
        if (moved) { var r = root.getBoundingClientRect(); localStorage.setItem(POSKEY, JSON.stringify({ x: r.left, y: r.top })); }
      });
      fab.addEventListener('click', function () { if (moved) { moved = false; return; } opened ? close() : open(false); });

      // ── 隐藏 / 叫回 ──
      var HIDEKEY = 'mfj-pet-hidden';
      function tuck() { close(); root.classList.add('tucked'); try { localStorage.setItem(HIDEKEY, '1'); } catch (e) {} }
      function untuck() { root.classList.remove('tucked'); try { localStorage.removeItem(HIDEKEY); } catch (e) {} }
      try { if (localStorage.getItem(HIDEKEY) === '1') root.classList.add('tucked'); } catch (e) {}
      document.getElementById('pet-hide').addEventListener('click', tuck);
      document.getElementById('pet-reopen').addEventListener('click', untuck);

      document.getElementById('pet-x').addEventListener('click', close);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && opened) { close(); fab.focus(); } });
      // 点面板外关闭
      document.addEventListener('pointerdown', function (e) {
        if (opened && !panel.contains(e.target) && !fab.contains(e.target)) close();
      });
      form.addEventListener('submit', function (e) { e.preventDefault(); open(true); send(input.value.trim()); });
      sugs.addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) { open(true); send(b.dataset.q); } });

      // 首次问候气泡：滚动一点后冒出来，几秒后自动收起
      setTimeout(function () {
        if (greeted || opened) return; greeted = true;
        hi.classList.add('show');
        setTimeout(function () { hi.classList.remove('show'); }, 6000);
      }, 2600);
    })();
