const knowledgeZones = [
  { icon: '📥', name: 'raw / 输入源', stat: '16 GB', desc: 'Plaud 录音转写 1402 个 · BuilderPulse 中英文头条池 · 切曼课程录音 170 个 · 巴菲特股东信' },
  { icon: '🧠', name: 'Knowledge / 知识沉淀', stat: '930 MB', desc: '中台项目档案（架构/PRD/调研/实施手册）· 合规审核体系 · 哲学与认知心理学笔记' },
  { icon: '✍️', name: 'Writing / 内容产出', stat: '2300+ md', desc: '抖音口播稿 280 篇（20 周连续 5 公式覆盖🏆）· 公众号 338 篇 · 小红书 346 篇 · 切曼讲稿 23 节' },
  { icon: '🛠', name: 'Software / 工具资产', stat: '25+ skills', desc: '写作方法论 skill 库 · 抖音口播 2.0 人设热点公式 · Agent 项目源码 · RAG / workflow 工程' },
  { icon: '📚', name: 'WIKI / 概念库', stat: '55 概念', desc: 'Vibe Coding · Agent 记忆体系 · 模型选型 · 竞品分析——Karpathy 风格编译产物' },
  { icon: '⚙️', name: 'Meta / 治理', stat: '8 规则', desc: 'CLAUDE.md 编译规范 · 内容生产规则 · 每日工作流 · 自动备份 launchd 双任务' },
];


const geekGear = [
  { icon: '🤖', name: 'Agentic Coding', status: 'DAILY DRIVER', desc: 'Claude Code 多 Agent 并行编排 + 后台任务 + Workflow 脚本。本站 156 页（3D 星场 / 知识图谱 / 全文系统）即由 Agent 全程构建。' },
  { icon: '🌐', name: '浏览器操作 Agent', status: 'IN PRODUCTION', desc: 'Claude in Chrome / browser-use 范式：AI 自己打开页面、截图、验证交互。本站每个版本上线前由 AI 在真实浏览器里自检回归。' },
  { icon: '🕸', name: 'Multi-Agent Workflow', status: 'DAILY DRIVER', desc: 'fan-out 并行调研 + 对抗验证 + 流水线编排。内容周批次、知识库扫描全部多 Agent 并行跑。' },
  { icon: '🧩', name: 'MCP 协议工程', status: 'IN PRODUCTION', desc: '薄包装策略：70% 复用既有接口、20 个 Tool 覆盖全业务域；飞书全家桶（Base / 文档 / 事件流 / 妙记）经 CLI 接入 Agent。' },
  { icon: '⚡️', name: 'Skill 工程化', status: 'SHIPPING', desc: '25+ 写作方法论 skill：抖音口播 2.0 人设热点双引擎、口播四步法、公众号爆款——从"指挥 AI"到"管理 AI"。' },
  { icon: '📚', name: 'LLM Wiki 知识编译', status: 'SHIPPING', desc: 'Karpathy 风格 raw→wiki 编译管线：双链、实体/概念/来源分型。本站 178 节点知识图谱就是编译产物。' },
  { icon: '🔍', name: 'RAG 混合检索', status: 'IN PRODUCTION', desc: 'BM25 优先 + pgvector 语义辅助、结构化字段先筛掉 90%；MySQL → PostgreSQL 平滑演进。' },
  { icon: '🎛', name: 'LLM 应用编排', status: 'IN PRODUCTION', desc: 'Dify / LobeHub 双栈：6 业务域 SubAgent、6 阶段意图识别 Pipeline、组合意图 + 会话对象栈（Entity Stack）。' },
  { icon: '🎨', name: 'AIGC 视觉工作流', status: 'SHIPPED', desc: 'ComfyUI + Lora 微调（10 万+ 训练数据，生图采纳率 65%→87%）；Seedance / Sora2 / Veo 工业化视频生产。' },
  { icon: '🛡', name: '多模态审核', status: 'SHIPPED', desc: 'Gemini 2.5 Flash/Pro 文本 / 图像 / 视频三模态"源头把控 + 终筛"，5000+ 条评测集支撑。' },
  { icon: '📊', name: 'LLM 可观测', status: 'IN PRODUCTION', desc: 'Langfuse 全链路 tracing + 评测集 / badcase 闭环 + Token 成本看板——AI 系统不能是黑盒。' },
  { icon: '🔁', name: '无人值守自动化', status: 'DAILY DRIVER', desc: 'launchd / cron 定时矩阵：每日内容生产、晨晚双轨备份、IMAP 录音附件拉取——睡觉时系统在干活。' },
  { icon: '🗣', name: '语音 & 数字人', status: 'SHIPPED', desc: 'Whisper 转写 1402 条录音入库 + TTS 配音 + 数字人口播，录音直达多平台成稿。' },
  { icon: '📡', name: '信息采集流水线', status: 'DAILY DRIVER', desc: 'BuilderPulse 中英热点池 git 自动拉取 + 邮件附件抓取 + 社媒内容采集归档，输入端全自动。' },
  { icon: '🧪', name: 'Vibe Coding 原型术', status: 'DAILY DRIVER', desc: '单文件 HTML 高保真：20+ 可交互原型 + 看板 + 蓝图，"业务看得见、研发抄得走、老板拍得了板"。' },
