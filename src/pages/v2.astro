    num: '伪需求过滤器',
    title: '「先毙需求，后写代码」',
    desc: '3 小时多层级深访后干的第一件事不是立项，是毙掉「全 AI 一键出片」「自动养号」两个伪需求——毙对两个伪需求，比做对两个需求值钱，那是千万级研发资源。判据只有一条：业务目标 × 场景 = 价值。',
  },
  {
    num: '蓝图签字术',
    title: '「人人点头 ≠ 有人负责」',
    desc: '转型项目都死于"会上都同意、会后没人管"。让业务方在蓝图上签字——签字那一刻，组织才真正开始转型。这招从 ERP 时代炼到 Agent 时代，技术换了三代，人性没变。',
  },
  {
    num: '形态收敛刀法',
    title: '「单条 = 批量 = 同一道工序」',
    desc: '产品做到 v15 积了几十个功能入口，一刀收敛：批量不是另一个产品，是同一道工序作用在 N 张卡上。规则/模板/词包是可换的包，工序永远只有一道。几十个功能瞬间归位。',
  },
  {
    num: '工序引擎三轴',
    title: '「加能力靠声明，不靠改界面」',
    desc: '工序是一份声明、承载壳是唯一交互容器、交付物恒为一张卡——三轴正交，改任何一轴不动另外两轴。新工作流 = 注册表里加一行数据，界面零改动。架构的美感就是这种"焊不死"。',
  },
  {
    num: '可运行产物主义',
    title: '「PRD 会撒谎，原型不会」',
    desc: '三天迭代八版可交互原型（v1→v8）：业务看得见、研发抄得走、老板拍得了板，沟通损耗降一个量级。产品经理的新工作流：从"写文档等排期"到"直接搭出可验证的产品形态"。',
  },
  {
    num: '人机协作四原则',
    title: '「方向盘永远在人手里」',
    desc: 'AI 做重活、人做判断；可中断、可覆盖、可回滚；不讲模型原理、只讲"为什么推荐这个、哪里不确定"；把出错当默认状态设计。信任不是宣传出来的，是交互设计出来的。',
  },
  {
    num: 'FDE 驻场术',
    title: '「答案在业务现场，不在会议室」',
    desc: '驻场在运营工位旁边，不在产品会议室里：白天跟业务一线对齐场景，晚上与集团 CIO 双周汇报、向亚洲区总经理英文汇报。FDE 的本质是需求的翻译官 + 新工具的布道师——理解业务后设计 AI Native 架构，再反哺公司战略。',
  },
  {
    num: '转型飞轮分工',
    title: '「交付会结束，飞轮不会」',
    desc: '一次性交付是转型最大的失败形态。设计「业务变化（Skill + 数据）归运营维护、技术稳定（代码）归工程维护」的分工矩阵，配四层转型组织——项目组撤了，系统还在自己长大。从 ERP 到硅基员工到 AI 中台，三段转型都靠这个飞轮活下来。',
  },
  {
    num: '吃自己的狗粮',
    title: '「给业务装 AI 前，先把自己 AI 化」',
    desc: '280 篇口播稿 20 周连续生产、156 页个站全程 Agent 构建、知识库由编译管线自动维护——自己的生产方式先跑通闭环，才有资格给 70 人团队做转型。自己淋过雨，才配给别人撑伞。',
  },
];

const skills = [
  {
    cat: 'AGENT / LLM',
    items: ['Multi-Agent 架构', 'Orchestrator 编排', 'MCP / Skill', 'Dify', 'LobeHub', 'LangChain', 'RAG / 混合检索', 'Prompt Engineering', 'SFT / Lora 微调', 'AB Test'],
  },
  {
    cat: 'CODING / INFRA',
    items: ['Claude Code', 'Cursor', 'Vibe Coding', 'Docker', 'PostgreSQL + pgvector', 'Langfuse 可观测', '评测集 / badcase', '埋点 Schema'],
  },
  {
    cat: 'AIGC / 多模态',
    items: ['ComfyUI 工作流', 'Lora 微调', 'Sora2 / Veo / Seedance', 'Gemini 2.5 多模态审核', '数字人 / 配音'],
  },
  {
    cat: '产品 / 转型',
    items: ['AARRR', '双轨指标体系', 'PRD / 高保真原型', '用户旅程图谱', '数字化转型', '变革管理', 'PMP', '英文工作语言'],
  },
