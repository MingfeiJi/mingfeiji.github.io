---
import Base from '../layouts/Base.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import { getCollection } from 'astro:content';
import graphData from '../data/graph.json';

const graphNodeCount = (graphData.nodes as any[]).length;
const graphLinkCount = (graphData.links as any[]).length;

const allArticles = (await getCollection('articles')).sort(
  (a, b) => (b.data.created?.getTime() ?? 0) - (a.data.created?.getTime() ?? 0)
);
const featuredArticles = allArticles.slice(0, 14);
const totalArticleWords = allArticles.reduce((s, a) => s + (a.data.word_count ?? 3000), 0);

const works = [
  {
    tag: 'OPS PLAYBOOK',
    title: '内容增长 AI 中台 · 运营手册',
    desc: '出海内容 AI 中台的执行 SOP——业务蓝图签字机制、四层转型组织、飞轮分工矩阵的完整落地版。',
    meta: 'mingfeiji.github.io/tripflow-ops-playbook',
    url: 'https://mingfeiji.github.io/tripflow-ops-playbook/',
  },
  {
    tag: 'INTENT ATLAS',
