  <script is:inline>
    (function () {
      var host = document.getElementById('nebula-bg');
      if (!host) return;
      // 每个主题一套背景特效（独立特效文件，v2-scoped）
      var FX = {
        cosmos: '/cosmos-nebula.html', paper: '/paper-ink.html',
        klein: '/klein-fx.html', snow: '/snow-fx.html', hud: '/hud-field.html'
      };
      var curSrc = null;
      function sync() {
        // 屏蔽 BaseV2 自带的 #hud-field（它 opacity 卡 0 + 会和本层重复），统一由本层接管
        var legacy = document.getElementById('hud-field');
        if (legacy) legacy.style.setProperty('display', 'none', 'important');
        var src = FX[document.documentElement.getAttribute('data-theme')] || null;
        if (src === curSrc) return;
        curSrc = src;
        host.innerHTML = '';
        if (src) {
          var f = document.createElement('iframe');
          f.src = src; f.setAttribute('tabindex', '-1');
          f.setAttribute('scrolling', 'no'); f.setAttribute('aria-hidden', 'true');
          // 内联尺寸（动态 iframe 拿不到 Astro scoped 样式，必须内联，否则停在 300×150）
          f.style.cssText = 'width:100vw;height:100vh;border:0;display:block;';
          host.appendChild(f);
        }
      }
      new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      sync();
      // hero 深度视差：内容与星空反向微移，形成前/后景层次（仅精确指针 + 允许动效时）
      // 平滑交给 CSS transition，事件里直接写目标值，无常驻 rAF
      var hero = document.querySelector('.hero');
      var depthOn = hero && matchMedia('(pointer:fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (depthOn) {
        hero.style.transition = 'transform 1.1s cubic-bezier(.16,.6,.3,1)';
        hero.style.willChange = 'transform';
      }
      addEventListener('pointermove', function (e) {
        var x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
        if (depthOn) hero.style.transform = 'translate3d(' + (-x * 10).toFixed(2) + 'px,' + (-y * 8).toFixed(2) + 'px,0)';
        var f = host.querySelector('iframe');
        if (f && f.contentWindow) f.contentWindow.postMessage({ t: 'pointer', x: x, y: y }, '*');
      }, { passive: true });
    })();
  </script>

  <script is:inline>
    (function () {
      var rail = document.querySelector('.rail');
      if (!rail) return;
      var items = Array.prototype.slice.call(rail.querySelectorAll('.rail-item'));
      var fill = rail.querySelector('.rail-fill');
      var map = {};
      items.forEach(function (a) { map[a.getAttribute('data-spy')] = a; });
      var ids = items.map(function (a) { return a.getAttribute('data-spy'); });
      var current = null;
      function setActive(id) {
        if (id === current) return;
        current = id;
        items.forEach(function (a) {
          var on = a.getAttribute('data-spy') === id;
          a.classList.toggle('active', on);
          if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
        });
      }
      // 阅读线判定：取"顶部已越过视口 1/3 线"的最后一个章节，对高矮章节都稳
      function onScroll() {
        var line = innerHeight * 0.33, best = ids[0];
        ids.forEach(function (id) {
          var el = document.getElementById(id);
          if (el && el.getBoundingClientRect().top <= line) best = id;
        });
        // 触底时强制点亮最后一节
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) best = ids[ids.length - 1];
        setActive(best);
        rail.classList.toggle('show', scrollY > innerHeight * 0.6);
        var max = document.documentElement.scrollHeight - innerHeight;
        if (fill && max > 0) fill.style.height = Math.max(0, Math.min(100, (scrollY / max) * 100)) + '%';
      }
      // 平滑跳转 + 尊重 reduced-motion
      var smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      items.forEach(function (a) {
        a.addEventListener('click', function (e) {
          var id = a.getAttribute('data-spy');
          var el = document.getElementById(id);
          if (!el) return;
          e.preventDefault();
          el.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
          history.replaceState(null, '', '#' + id);
        });
      });
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      onScroll();
    })();
  </script>

