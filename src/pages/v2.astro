  { ver: 'NEW', name: '灵感引擎 · 高保真 v1', note: '6-09 · 最新迭代', slug: 'inspiration-engine' },
  { ver: 'v8', name: '内容工作台 · 信息架构地图', note: '6-08 · IA 总图', slug: 'workbench-v8' },
  { ver: 'BP', name: '产品形态整合蓝图', note: '6-08 · 形态收敛', slug: 'product-blueprint' },
  { ver: 'SYS', name: '系统蓝图 · 六合一工作台', note: '6-05 · OOUX 五视角', slug: 'system-blueprint' },
  { ver: 'MAP', name: '47 意图旅程图谱', note: '6-07 · 体验底层', slug: 'intent-47-journeys' },
