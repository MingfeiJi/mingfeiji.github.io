---
import Base from '../layouts/BaseV2.astro';

const loop = [
  ['01', 'Intent', '把模糊愿望压成一句可验证的问题'],
  ['02', 'Spec', '明确边界、状态、失败与验收方式'],
  ['03', 'Prototype', '先交付一个可运行的判断对象'],
  ['04', 'Agent', '把任务拆给适合的模型、Skill 与工具'],
  ['05', 'Evaluate', '用截图、测试和 badcase 对抗自嗨'],
  ['06', 'Ship', 'Preview 可审阅，Production 可回滚'],
  ['07', 'Compound', '把本轮经验沉淀成下一轮的资产'],
];
---

<Base
  title="Vibe Coding Lab · 纪鸣飞的可运行构建现场"
  description="三个可玩的生成式视觉实验，以及纪鸣飞从意图、规格、原型、Agent、评测到发布的 Vibe Coding 闭环。"
  immersive={true}
>
  <div class="vibe-page" id="top">
    <header class="vibe-hero">
      <canvas id="intent-canvas" aria-label="由混沌粒子收敛成结构的意图星核"></canvas>
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-copy">
        <div class="eyebrow"><span></span> VIBE CODING / LIVE LAB 001</div>
        <h1>把一句想法<br /><em>炼成可运行现场</em></h1>
        <p>
          我不把 Vibe Coding 理解成“让 AI 多写代码”，而是把意图、规格、原型、评测和发布压进同一个高速闭环。
          下面不是效果图，是三件可以亲手改变的视觉仪器。
        </p>
        <div class="hero-actions">
          <a class="vibe-btn primary" href="#experiments">开始交互</a>
          <a class="vibe-btn" href="#operating-loop">查看构建闭环</a>
        </div>
      </div>
      <div class="hero-console" aria-label="实验状态">
        <div><span>MODE</span><b>BUILDING IN PUBLIC</b></div>
        <div><span>INPUT</span><b>AMBIGUOUS INTENT</b></div>
        <div><span>OUTPUT</span><b>RUNNABLE ARTIFACT</b></div>
        <div class="live"><span>STATUS</span><b><i></i> SYSTEM ALIVE</b></div>
      </div>
      <div class="hero-orbit" aria-hidden="true"><span>INTENT</span><span>SPEC</span><span>SHIP</span></div>
    </header>

    <div class="vibe-main">
      <section class="manifesto section-wrap reveal">
        <div class="manifesto-index">00 / MANIFESTO</div>
        <p>不要用文档描述一个未来产品。<strong>先让它在浏览器里呼吸一次。</strong></p>
        <div class="manifesto-meta">Idea → Interface → Evidence</div>
      </section>

      <section class="experiments section-wrap" id="experiments">
        <div class="section-head reveal">
          <div>
            <div class="section-kicker">INTERACTIVE ARTIFACTS / 03</div>
            <h2>三个视觉仪器，三种构建隐喻</h2>
          </div>
          <p>鼠标、触控、键盘均可操作；减少动态模式下会自动降级为静态构图。</p>
        </div>

        <article class="instrument instrument-core reveal" data-lab="core">
          <div class="instrument-copy">
            <div class="instrument-no">EXPERIMENT 01 · THREE.JS</div>
            <h3>意图星核<br /><em>Intent Matter</em></h3>
            <p>模糊需求像高能粒子云。规格不是给它加更多文字，而是不断减少自由度，直到团队看见同一个结构。</p>
            <div class="instrument-proof">
              <span>输入：模糊愿望</span><span>控制：清晰度</span><span>产物：可验证结构</span>
            </div>
          </div>
          <div class="lab-stage core-stage">
            <div class="core-reticle" aria-hidden="true"></div>
            <div class="core-readout" aria-live="polite">
              <span>STRUCTURAL CLARITY</span>
              <strong id="clarity-value">42%</strong>
            </div>
            <div class="lab-controls core-controls">
              <label>
                <span>混沌</span>
                <input id="clarity" type="range" min="0" max="100" value="42" aria-label="意图清晰度" />
                <span>收敛</span>
              </label>
              <button id="scatter-core" type="button">打散意图</button>
              <button id="resolve-core" class="hot" type="button">锁定规格</button>
            </div>
          </div>
        </article>

        <article class="instrument instrument-agents reveal" data-lab="agents">
          <div class="instrument-copy">
            <div class="instrument-no">EXPERIMENT 02 · CANVAS</div>
            <h3>智能体星图<br /><em>Agent Constellation</em></h3>
            <p>好的 Agent 系统不是一群同时说话的模型，而是一条有状态、有回退、有证据的信号路径。点击任一阶段，观察整条链路如何回应。</p>
            <div class="phase-picker" aria-label="选择构建阶段">
              {loop.map(([no, name]) => <button type="button" data-phase={Number(no) - 1}><span>{no}</span>{name}</button>)}
            </div>
          </div>
          <div class="lab-stage agent-stage">
            <canvas id="agent-canvas" tabindex="0" aria-label="七阶段 Agent 构建闭环星图"></canvas>
            <div class="agent-status" aria-live="polite">
              <span id="agent-step">READY / 点击运行整个闭环</span>
              <button id="run-loop" class="hot" type="button">RUN LOOP</button>
            </div>
          </div>
        </article>

        <article class="instrument instrument-signal reveal" data-lab="signal">
          <div class="instrument-copy">
            <div class="instrument-no">EXPERIMENT 03 · GENERATIVE FIELD</div>
            <h3>信号花园<br /><em>Signal Garden</em></h3>
            <p>Prompt 不是咒语，是对概率空间施加方向。移动指针改变场，调节信号强度，看看结构何时从噪声里长出来。</p>
            <div class="instrument-proof">
              <span>移动：施加意图</span><span>滑杆：信噪比</span><span>点击：重新播种</span>
            </div>
          </div>
          <div class="lab-stage signal-stage">
            <canvas id="signal-canvas" tabindex="0" aria-label="可用指针改变方向的生成式信号流场"></canvas>
            <div class="signal-caption"><span>MOVE TO CULTIVATE</span><i></i><span>FIELD 03</span></div>
            <div class="lab-controls signal-controls">
              <label>
                <span>NOISE</span>
                <input id="coherence" type="range" min="0" max="100" value="68" aria-label="信号强度" />
                <span>SIGNAL</span>
              </label>
              <button id="reseed" type="button">RESEED FIELD</button>
            </div>
          </div>
        </article>
      </section>

      <section class="operating-loop section-wrap" id="operating-loop">
        <div class="section-head reveal">
          <div>
            <div class="section-kicker">OPERATING SYSTEM / 07 STEPS</div>
            <h2>惊艳只是入口，闭环才是作品</h2>
          </div>
          <p>每一步都必须留下一个真实产物，让下一步不是凭感觉继续。</p>
        </div>
        <ol class="loop-grid">
          {loop.map(([no, name, desc], index) => (
            <li class="reveal" style={`--delay:${index * 55}ms`}>
              <div class="loop-no">{no}</div>
              <h3>{name}</h3>
              <p>{desc}</p>
              <div class="loop-artifact">{['BRIEF', 'PRD', 'PROTOTYPE', 'AGENT CONFIG', 'TEST', 'PREVIEW', 'SKILL'][index]}</div>
            </li>
          ))}
        </ol>
      </section>

      <section class="build-log section-wrap reveal">
        <div class="build-log-copy">
          <div class="section-kicker">BUILD LOG / CURRENT ITERATION</div>
          <h2>这批作品本身，就是一条 Vibe Coding 证据链</h2>
          <p>设计约束、交互实现、性能降级、移动端适配和构建验证会一起进入版本记录。不是“我会这些工具”，而是“这里就是正在运行的产物”。</p>
        </div>
        <div class="build-terminal" aria-label="构建记录">
          <div><span>01</span><b>Intent Matter</b><em>Three.js / particle deformation</em><i>SHIPPED</i></div>
          <div><span>02</span><b>Agent Constellation</b><em>Canvas / state choreography</em><i>SHIPPED</i></div>
          <div><span>03</span><b>Signal Garden</b><em>Generative field / pointer input</em><i>SHIPPED</i></div>
          <div><span>04</span><b>Next artifact</b><em>Case → commit → preview timeline</em><i class="next">BUILDING</i></div>
        </div>
      </section>

      <section class="vibe-cta section-wrap reveal">
        <div>
          <span>THE NEXT BUILD STARTS WITH ONE SENTENCE.</span>
          <h2>有一个复杂想法？<br />我们先把它做成能点开的东西。</h2>
        </div>
        <div class="hero-actions">
          <a class="vibe-btn primary" href="mailto:1966315939@qq.com?subject=Vibe%20Coding%20共创">发起一次共创</a>
          <a class="vibe-btn" href="/#works">查看其他作品</a>
        </div>
      </section>
    </div>
  </div>

  <script>
    import * as THREE from 'three';

    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clampDpr = () => Math.min(devicePixelRatio || 1, 1.5);

    // EXPERIMENT 01 — intent matter
    const intentCanvas = document.querySelector<HTMLCanvasElement>('#intent-canvas');
    const clarityInput = document.querySelector<HTMLInputElement>('#clarity');
    const clarityValue = document.querySelector<HTMLElement>('#clarity-value');
    if (intentCanvas && clarityInput && clarityValue) {
      const renderer = new THREE.WebGLRenderer({ canvas: intentCanvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(clampDpr());
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(36, 1, 0.1, 30);
      camera.position.z = 4.4;
      const geometry = new THREE.IcosahedronGeometry(1.18, 4);
      const base = new Float32Array(geometry.attributes.position.array as ArrayLike<number>);
      const points = new THREE.Points(
        geometry,
        new THREE.PointsMaterial({ color: 0x78e8ff, size: 0.018, transparent: true, opacity: 0.92, blending: THREE.AdditiveBlending, depthWrite: false })
      );
      const wire = new THREE.Mesh(
        new THREE.IcosahedronGeometry(1.17, 2),
        new THREE.MeshBasicMaterial({ color: 0x8c6cff, wireframe: true, transparent: true, opacity: 0.11 })
      );
      scene.add(points, wire);
      let clarity = Number(clarityInput.value) / 100;
      let aimX = 0;
      let aimY = 0;
      let visible = true;
      let intentDirty = true;
      let last = 0;

      const resizeIntent = () => {
        const box = intentCanvas.getBoundingClientRect();
        renderer.setSize(Math.max(1, box.width), Math.max(1, box.height), false);
        camera.aspect = box.width / Math.max(1, box.height);
        camera.updateProjectionMatrix();
        intentDirty = true;
      };
      new ResizeObserver(resizeIntent).observe(intentCanvas);
      resizeIntent();

      const updateClarity = (value: number) => {
        clarity = value / 100;
        clarityInput.value = String(value);
        clarityValue.textContent = `${Math.round(value)}%`;
        intentDirty = true;
      };
      clarityInput.addEventListener('input', () => updateClarity(Number(clarityInput.value)));
      document.querySelector('#scatter-core')?.addEventListener('click', () => updateClarity(12));
      document.querySelector('#resolve-core')?.addEventListener('click', () => updateClarity(92));
      intentCanvas.addEventListener('pointermove', (event) => {
        const rect = intentCanvas.getBoundingClientRect();
        aimX = (event.clientX - rect.left) / rect.width - 0.5;
        aimY = (event.clientY - rect.top) / rect.height - 0.5;
        intentDirty = true;
      });
      new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; intentDirty = true; }, { threshold: 0.02 }).observe(intentCanvas);

      const renderIntent = (now: number) => {
        requestAnimationFrame(renderIntent);
        if (!visible || document.hidden || (reducedMotion && !intentDirty)) return;
        const time = reducedMotion ? 0.6 : now * 0.00035;
        if (!reducedMotion && now - last < 24) return;
        last = now;
        const positions = geometry.attributes.position.array as Float32Array;
        const disorder = (1 - clarity) * 0.54;
        for (let i = 0; i < positions.length; i += 3) {
          const bx = base[i], by = base[i + 1], bz = base[i + 2];
          const wave = Math.sin(bx * 5.2 + time * 3) * Math.cos(by * 4.3 - time * 2.1) * Math.sin(bz * 3.7 + time);
          const radial = 1 + wave * disorder;
          positions[i] = bx * radial + Math.sin(by * 8 + time * 4) * disorder * 0.12;
          positions[i + 1] = by * radial + Math.cos(bz * 7 - time * 3) * disorder * 0.12;
          positions[i + 2] = bz * radial;
        }
        geometry.attributes.position.needsUpdate = true;
        points.rotation.y += reducedMotion ? 0 : 0.0018 + clarity * 0.0016;
        points.rotation.x += (aimY * 0.38 - points.rotation.x) * 0.025;
        points.rotation.z += (-aimX * 0.22 - points.rotation.z) * 0.025;
        wire.rotation.copy(points.rotation);
        const material = points.material as THREE.PointsMaterial;
        material.color.setHSL(0.52 + clarity * 0.18, 0.88, 0.68);
        wire.scale.setScalar(0.98 + clarity * 0.04);
        renderer.render(scene, camera);
        intentDirty = false;
      };
      requestAnimationFrame(renderIntent);
    }

    // EXPERIMENT 02 — agent constellation
    const agentCanvas = document.querySelector<HTMLCanvasElement>('#agent-canvas');
    const runLoop = document.querySelector<HTMLButtonElement>('#run-loop');
    const agentStep = document.querySelector<HTMLElement>('#agent-step');
    const phaseButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-phase]')];
    if (agentCanvas && runLoop && agentStep) {
      const ctx = agentCanvas.getContext('2d');
      const names = ['INTENT', 'SPEC', 'PROTOTYPE', 'AGENT', 'EVALUATE', 'SHIP', 'COMPOUND'];
      let width = 1, height = 1, active = -1, pulseStart = performance.now(), running = false, loopStart = 0, hovered = -1;
      let agentVisible = false, agentDirty = true;
      let pointer = { x: -999, y: -999 };
      const resizeAgent = () => {
        const rect = agentCanvas.getBoundingClientRect();
        width = rect.width; height = rect.height;
        const dpr = clampDpr();
        agentCanvas.width = Math.max(1, Math.round(width * dpr));
        agentCanvas.height = Math.max(1, Math.round(height * dpr));
        ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
        agentDirty = true;
      };
      new ResizeObserver(resizeAgent).observe(agentCanvas);
      resizeAgent();
      const nodePositions = () => names.map((_, i) => {
        const angle = -Math.PI / 2 + (i / names.length) * Math.PI * 2;
        const radius = Math.min(width, height) * 0.33;
        return { x: width / 2 + Math.cos(angle) * radius, y: height / 2 + Math.sin(angle) * radius };
      });
      const selectPhase = (index: number) => {
        active = index;
        pulseStart = performance.now();
        agentDirty = true;
        agentStep.textContent = `${String(index + 1).padStart(2, '0')} / ${names[index]} · SIGNAL ACCEPTED`;
        phaseButtons.forEach((button, i) => button.classList.toggle('active', i === index));
      };
      phaseButtons.forEach((button) => button.addEventListener('click', () => selectPhase(Number(button.dataset.phase))));
      runLoop.addEventListener('click', () => {
        running = true; loopStart = performance.now(); selectPhase(0);
        runLoop.textContent = 'RUNNING…';
      });
      agentCanvas.addEventListener('pointermove', (event) => {
        const rect = agentCanvas.getBoundingClientRect();
        pointer = { x: event.clientX - rect.left, y: event.clientY - rect.top };
        agentDirty = true;
      });
      agentCanvas.addEventListener('pointerleave', () => { pointer = { x: -999, y: -999 }; hovered = -1; agentDirty = true; });
      agentCanvas.addEventListener('click', () => { if (hovered >= 0) selectPhase(hovered); });
      agentCanvas.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); runLoop.click(); }
      });
      new IntersectionObserver(([entry]) => { agentVisible = entry.isIntersecting; agentDirty = true; }, { threshold: 0.02 }).observe(agentCanvas);

      const drawAgents = (now: number) => {
        requestAnimationFrame(drawAgents);
        if (!ctx || !agentVisible || document.hidden || (reducedMotion && !agentDirty && !running)) return;
        if (running) {
          const step = Math.min(6, Math.floor((now - loopStart) / 720));
          if (step !== active) selectPhase(step);
          if (now - loopStart > 7 * 720) {
            running = false; runLoop.textContent = 'RUN AGAIN'; agentStep.textContent = 'LOOP COMPOUNDED · 7 ARTIFACTS SAVED';
          }
        }
        ctx.clearRect(0, 0, width, height);
        const nodes = nodePositions();
        const bg = ctx.createRadialGradient(width / 2, height / 2, 20, width / 2, height / 2, Math.min(width, height) * 0.52);
        bg.addColorStop(0, 'rgba(53, 220, 255, .08)'); bg.addColorStop(1, 'rgba(5, 8, 17, 0)');
        ctx.fillStyle = bg; ctx.fillRect(0, 0, width, height);
        hovered = -1;
        ctx.lineWidth = 1;
        nodes.forEach((node, i) => {
          const next = nodes[(i + 1) % nodes.length];
          const lit = active >= 0 && (i <= active || (active === 6 && i === 6));
          const line = ctx.createLinearGradient(node.x, node.y, next.x, next.y);
          line.addColorStop(0, lit ? 'rgba(82,229,255,.9)' : 'rgba(131,147,180,.18)');
          line.addColorStop(1, lit ? 'rgba(158,112,255,.65)' : 'rgba(131,147,180,.08)');
          ctx.strokeStyle = line; ctx.setLineDash([4, 8]); ctx.lineDashOffset = reducedMotion ? 0 : -now * 0.02;
          ctx.beginPath(); ctx.moveTo(node.x, node.y); ctx.lineTo(next.x, next.y); ctx.stroke();
          if (active === i) {
            const p = reducedMotion ? 0.35 : ((now - pulseStart) % 1100) / 1100;
            ctx.strokeStyle = `rgba(118, 235, 255, ${1 - p})`; ctx.setLineDash([]); ctx.lineWidth = 2;
            ctx.beginPath(); ctx.arc(node.x, node.y, 23 + p * 34, 0, Math.PI * 2); ctx.stroke();
          }
        });
        ctx.setLineDash([]);
        nodes.forEach((node, i) => {
          const dist = Math.hypot(pointer.x - node.x, pointer.y - node.y);
          if (dist < 34) hovered = i;
          const on = i === active || i === hovered;
          const radius = on ? 18 : 13;
          const glow = ctx.createRadialGradient(node.x, node.y, 1, node.x, node.y, radius * 3.1);
          glow.addColorStop(0, on ? 'rgba(110,237,255,.9)' : 'rgba(129,149,195,.42)');
          glow.addColorStop(1, 'rgba(37,54,90,0)');
          ctx.fillStyle = glow; ctx.beginPath(); ctx.arc(node.x, node.y, radius * 3.1, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = on ? '#d7faff' : '#75839e'; ctx.beginPath(); ctx.arc(node.x, node.y, radius, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = '#070b14'; ctx.font = '700 9px JetBrains Mono, monospace'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
          ctx.fillText(String(i + 1).padStart(2, '0'), node.x, node.y + 0.5);
          ctx.fillStyle = on ? '#d8f8ff' : '#7f8da8'; ctx.font = '10px JetBrains Mono, monospace';
          ctx.fillText(names[i], node.x, node.y + 34);
        });
        ctx.fillStyle = '#d9f8ff'; ctx.font = '700 14px JetBrains Mono, monospace'; ctx.textAlign = 'center';
        ctx.fillText(active >= 0 ? names[active] : 'AGENT LOOP', width / 2, height / 2 - 4);
        ctx.fillStyle = '#64718c'; ctx.font = '10px JetBrains Mono, monospace';
        ctx.fillText(active >= 0 ? 'ARTIFACT VERIFIED' : '7 NODES / 1 STATE', width / 2, height / 2 + 17);
        agentDirty = false;
      };
      requestAnimationFrame(drawAgents);
    }

    // EXPERIMENT 03 — signal garden
    const signalCanvas = document.querySelector<HTMLCanvasElement>('#signal-canvas');
    const coherenceInput = document.querySelector<HTMLInputElement>('#coherence');
    const reseed = document.querySelector<HTMLButtonElement>('#reseed');
    if (signalCanvas && coherenceInput && reseed) {
      const ctx = signalCanvas.getContext('2d');
      let width = 1, height = 1, particles: Array<{x:number;y:number;px:number;py:number;life:number;hue:number}> = [];
      let pointer = { x: 0, y: 0, active: false };
      let hueShift = 0, signalVisible = false, signalDirty = true;
      const particleCount = reducedMotion ? 70 : 230;
      const seedParticles = () => {
        particles = Array.from({ length: particleCount }, (_, i) => {
          const x = Math.random() * width, y = Math.random() * height;
          return { x, y, px: x, py: y, life: Math.random() * 180, hue: (i / particleCount) * 72 };
        });
      };
      const resizeSignal = () => {
        const rect = signalCanvas.getBoundingClientRect();
        width = rect.width; height = rect.height;
        const dpr = clampDpr();
        signalCanvas.width = Math.max(1, Math.round(width * dpr)); signalCanvas.height = Math.max(1, Math.round(height * dpr));
        ctx?.setTransform(dpr, 0, 0, dpr, 0, 0); seedParticles(); signalDirty = true;
      };
      new ResizeObserver(resizeSignal).observe(signalCanvas); resizeSignal();
      const setPointer = (event: PointerEvent) => {
        const rect = signalCanvas.getBoundingClientRect();
        pointer = { x: event.clientX - rect.left, y: event.clientY - rect.top, active: true };
        signalDirty = true;
      };
      signalCanvas.addEventListener('pointermove', setPointer);
      signalCanvas.addEventListener('pointerdown', setPointer);
      signalCanvas.addEventListener('pointerleave', () => { pointer.active = false; });
      reseed.addEventListener('click', () => { hueShift = (hueShift + 47) % 180; seedParticles(); signalDirty = true; });
      coherenceInput.addEventListener('input', () => { signalDirty = true; });
      signalCanvas.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); reseed.click(); }
      });
      new IntersectionObserver(([entry]) => { signalVisible = entry.isIntersecting; signalDirty = true; }, { threshold: 0.02 }).observe(signalCanvas);
      const drawSignal = () => {
        requestAnimationFrame(drawSignal);
        if (!ctx || !signalVisible || document.hidden || (reducedMotion && !signalDirty)) return;
        const coherence = Number(coherenceInput.value) / 100;
        ctx.fillStyle = reducedMotion ? 'rgba(5,8,17,1)' : 'rgba(5,8,17,.055)'; ctx.fillRect(0, 0, width, height);
        ctx.lineWidth = 0.65 + coherence * 0.75;
        particles.forEach((p) => {
          p.px = p.x; p.py = p.y;
          const nx = (p.x - width / 2) / Math.max(width, 1);
          const ny = (p.y - height / 2) / Math.max(height, 1);
          let angle = Math.sin(nx * 11 + ny * 3.2) * 1.8 + Math.cos(ny * 8 - nx * 2) * (1.1 - coherence);
          if (pointer.active) {
            const dx = p.x - pointer.x, dy = p.y - pointer.y;
            const distance = Math.max(24, Math.hypot(dx, dy));
            if (distance < 190) angle += Math.atan2(dy, dx) + (1 - distance / 190) * 1.9;
          }
          const speed = 0.45 + coherence * 1.25;
          if (reducedMotion) {
            p.x = p.px + Math.cos(angle) * 12;
            p.y = p.py + Math.sin(angle) * 12;
          } else {
