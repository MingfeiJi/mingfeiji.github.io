---
import '@fontsource/noto-serif-sc/700.css';
import '@fontsource/jetbrains-mono/400.css';
import { profile, metrics, experiences, projects } from '../data/career';
const title = '纪鸣飞 · 高级 AI 产品经理 | 职业概览';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={`${profile.experience}。${profile.summary}`} />
    <link rel="canonical" href="https://mingfeiji.github.io/resume/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.summary} />
    <meta property="og:type" content="profile" />
    <meta property="og:image" content="https://mingfeiji.github.io/og-career-20261028.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#081426" />
  </head>
  <body>
    <a class="skip" href="#main">跳到主要内容</a>
    <nav aria-label="主导航"><a class="brand" href="/">纪鸣飞 <span>✦</span></a><div><a href="#projects">代表项目</a><a href="#experience">工作经历</a><a href="mailto:1966315939@qq.com">联系我 ↗</a></div></nav>
    <main id="main">
      <header class="intro">
        <p class="eyebrow">MINGFEI JI / AI PRODUCT MANAGEMENT</p>
        <div class="intro-grid">
          <div><p class="role">{profile.title}</p><h1>让 AI 进入业务生产线，<br /><span>让结果可度量。</span></h1><p class="summary">{profile.summary}</p><div class="actions"><a class="button" href="#projects">看代表项目 <span>↓</span></a><a href="/">探索完整作品站 ↗</a></div></div>
          <aside class="identity"><span class="identity-star" aria-hidden="true">✦</span><h2>纪鸣飞</h2><p>{profile.experience}</p><ul><li>出海内容增长</li><li>B 端 AI 产品架构</li><li>业务 Agent 与评测闭环</li></ul><a href="mailto:1966315939@qq.com">1966315939@qq.com ↗</a><p class="education">浙江农林大学 · 本科<br />信息管理与信息系统 · 2021 年毕业<br />PMP · 英文工作语言</p></aside>
        </div>
        <div class="metrics">{metrics.map(m => <div><strong>{m.value}</strong><span>{m.label}</span><small>{m.scope}</small></div>)}</div>
      </header>

      <section class="loop" aria-labelledby="loop-title"><div><p class="eyebrow">MY WAY OF WORKING</p><h2 id="loop-title">从业务问题，到下一轮迭代。</h2></div><ol><li><b>定义问题</b><span>访谈 · 场景 · 成功度量</span></li><li><b>交付产物</b><span>原型 · Agent · Skill</span></li><li><b>评测回归</b><span>评测集 · BadCase · 规则</span></li><li><b>业务反馈</b><span>质量 · 产能 · 转化</span></li></ol><p>模型负责语义判断，程序负责确定性执行；人可以解释、干预和回退。</p></section>

      <section id="projects"><div class="section-heading"><div><p class="eyebrow">SELECTED WORK / 2025–2026</p><h2>两条产品线，一套闭环能力。</h2></div><p>TripFlow 连接内容增长全流程。<br />TripYoyo 让 Agent 能力跨业务复用。</p></div><div class="project-grid">{projects.map(p => <article id={p.id}><div class="project-meta"><span>{p.group}</span><span>{p.status}</span></div><h3>{p.name}</h3><div class="result">{p.result}<small>{p.unit}</small></div><p>{p.problem}</p><details><summary>查看我的做法与指标口径 <span aria-hidden="true">＋</span></summary><p>{p.approach}</p><p class="scope">{p.note}</p></details></article>)}</div><p class="source-note">项目指标按 2026 年 10 月简历整理。不同项目、不同统计周期分别展示。</p></section>

      <section id="experience"><div class="section-heading"><div><p class="eyebrow">EXPERIENCE</p><h2>从企业数字化，到业务 AI 化。</h2></div><p>携程 · 更好玩 · vidaXL 中国</p></div><div class="timeline">{experiences.map(e => <article><div class="when">{e.period}<span>{e.legalName}</span></div><div><h3>{e.company}</h3><p class="job">{e.role}</p><p>{e.intro}</p><ul>{e.points.map(p => <li>{p}</li>)}</ul><div class="tags">{e.tags.map(t => <span>{t}</span>)}</div></article>)}</div></section>

      <section class="capabilities"><div><p class="eyebrow">CAPABILITIES</p><h2>能判断，也能亲手交付。</h2></div><dl><div><dt>产品与组织</dt><dd>需求共创 / 业务流程 / 产品形态 / 用户旅程 / 跨部门项目管理</dd></div><div><dt>Agent 系统</dt><dd>Agentic Harness / ReAct / MCP / Skill / Multi-Agent / RAG 与记忆</dd></div><div><dt>工程与评测</dt><dd>Claude Code / Codex / Dify / 评测集 / BadCase 归因 / 同集回归</dd></div><div><dt>出海与增长</dt><dd>多平台内容策略 / 本地化 / 账号矩阵 / T+7 新客归因 / AARRR</dd></div></dl></section>
      <footer><p class="eyebrow">LET’S BUILD SOMETHING THAT WORKS</p><h2>聊聊你的业务，<br />以及 AI 能创造的价值。</h2><a class="button" href="mailto:1966315939@qq.com">邮件联系 <span>↗</span></a><div class="footer-links"><a href="/">完整作品站</a><a href="/prototypes/">可交互原型</a><a href="https://github.com/MingfeiJi" target="_blank" rel="noopener">GitHub ↗</a><span>纪鸣飞 · 2026</span></div></footer>
    </main>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth;scroll-padding-top:90px;background:#081426;color:#e8eff8} :global(body){margin:0;font-family:"PingFang SC","Microsoft YaHei",system-ui,sans-serif;font-size:15px;line-height:1.8;-webkit-font-smoothing:antialiased} :global(a){color:inherit;text-decoration:none} :global(a:hover){color:#9cd9ef} :global(a:focus-visible),summary:focus-visible{outline:2px solid #9cd9ef;outline-offset:6px} :global(h1),:global(h2),:global(h3),:global(p){margin:0} :global(section){scroll-margin-top:90px}
  .skip{position:absolute;top:-60px;left:20px;background:#e8eff8;color:#081426;padding:10px;z-index:30}.skip:focus{top:10px}nav{height:76px;display:flex;align-items:center;justify-content:space-between;max-width:1240px;margin:auto;padding:0 40px;border-bottom:1px solid #27374d}nav>div{display:flex;gap:28px;font-size:13px}.brand{font-weight:700;font-size:19px;letter-spacing:.08em}.brand span{color:#9cd9ef}main{max-width:1240px;margin:auto;padding:0 40px}.eyebrow{font-family:"JetBrains Mono",monospace;font-size:11px;letter-spacing:.12em;color:#9cd9ef;line-height:1.8}.intro{padding:65px 0 0}.intro-grid{display:grid;grid-template-columns:1fr 260px;gap:70px;margin-top:27px}.role{font-size:17px;color:#b3c4d8;letter-spacing:.13em;margin-bottom:15px}h1{font-family:"Noto Serif SC",serif;font-size:clamp(28px,3.25vw,46px);line-height:1.65;font-weight:700;letter-spacing:-.025em}h1 span{color:#9cd9ef}.summary{color:#b3c4d8;font-size:16px;line-height:2;max-width:655px;margin-top:26px}.actions{display:flex;align-items:center;gap:26px;margin-top:30px;font-size:13px}.button{display:inline-flex;justify-content:space-between;align-items:center;gap:28px;background:#9cd9ef;color:#081426;border-radius:5px;padding:11px 20px;font-size:14px;font-weight:600}.button:hover{background:#c0eaff;color:#081426}.identity{border-left:1px solid #27374d;padding-left:30px;position:relative}.identity-star{display:block;font-size:30px;color:#9cd9ef;line-height:1;margin-bottom:16px}.identity h2{font-family:"Noto Serif SC",serif;font-size:28px;letter-spacing:.2em}.identity p{font-size:12px;color:#b3c4d8;margin:8px 0 15px}.identity ul{list-style:none;margin:0 0 17px;padding:0;font-size:14px}.identity li:before{content:'·';color:#9cd9ef;margin-right:12px}.identity>a{font-family:"JetBrains Mono",monospace;font-size:11px;color:#9cd9ef}.identity .education{font-size:11px;line-height:1.9;margin-top:20px;color:#a1b3c9}.metrics{display:grid;grid-template-columns:repeat(4,1fr);margin-top:50px;border-top:1px solid #27374d;border-bottom:1px solid #27374d;padding:28px 0}.metrics>div{padding:0 23px;border-left:1px solid #27374d}.metrics>div:first-child{padding-left:0;border:0}.metrics strong{display:block;color:#9cd9ef;font-family:"JetBrains Mono",monospace;font-size:clamp(18px,2.1vw,29px);letter-spacing:-.05em;white-space:nowrap}.metrics span{display:block;font-size:13px;margin:7px 0 3px}.metrics small{font-size:10px;color:#a1b3c9;display:block}.loop{margin:58px 0 80px;padding:28px 32px;background:#102039;border-radius:8px;display:grid;grid-template-columns:1fr 1.7fr;gap:22px 32px}.loop h2{font-size:19px;line-height:1.7;margin-top:8px}.loop ol{display:grid;grid-template-columns:repeat(4,1fr);list-style:none;padding:0;margin:0;align-self:center;gap:18px}.loop li{position:relative}.loop li:not(:last-child):after{content:'→';position:absolute;right:-8px;top:0;color:#6785a2}.loop b{display:block;font-size:13px}.loop span{display:block;font-size:10px;color:#a1b3c9;margin-top:6px}.loop>p{grid-column:1/-1;color:#a1b3c9;font-size:12px;border-top:1px solid #27374d;padding-top:14px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:30px}h2{font-size:27px;font-weight:600;line-height:1.5}.section-heading h2{margin-top:10px}.section-heading>p{font-size:12px;color:#a1b3c9}.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.project-grid article{padding:25px;background:#102039;border:1px solid #27374d;border-radius:8px}.project-meta{display:flex;justify-content:space-between;font-size:10px;color:#a1b3c9}.project-meta>span:first-child{font-family:"JetBrains Mono",monospace;color:#9cd9ef}h3{font-size:20px;line-height:1.5}.project-grid h3{margin-top:18px}.result{font-family:"JetBrains Mono",monospace;font-size:25px;color:#9cd9ef;line-height:1.4;margin:20px 0}.result small{display:block;font-family:"PingFang SC",sans-serif;font-size:11px;color:#a1b3c9;margin-top:7px}.project-grid p{font-size:13px;line-height:1.9;color:#b3c4d8}.project-grid details{margin-top:24px;border-top:1px solid #27374d;padding-top:16px}.project-grid summary{font-size:11px;cursor:pointer;display:flex;justify-content:space-between;gap:8px;list-style:none}.project-grid summary::-webkit-details-marker{display:none}.project-grid details[open] summary span{transform:rotate(45deg)}.project-grid details p{margin-top:15px;font-size:12px}.project-grid .scope{font-size:11px;color:#a1b3c9;border-left:2px solid #6785a2;padding-left:12px}.source-note{font-size:11px;color:#a1b3c9;margin-top:18px}#experience{margin-top:90px}.timeline article{display:grid;grid-template-columns:230px 1fr;gap:38px;padding:34px 0;border-top:1px solid #27374d}.when{font-family:"JetBrains Mono",monospace;color:#9cd9ef;font-size:13px}.when span{display:block;font-family:"PingFang SC",sans-serif;color:#a1b3c9;font-size:11px;margin-top:10px}.job{color:#9cd9ef;font-size:13px;margin-top:8px}.timeline p:not(.job){font-size:14px;color:#b3c4d8;margin-top:15px}.timeline ul{padding-left:18px;margin:18px 0;font-size:13px;color:#b3c4d8}.timeline li{margin-top:10px;padding-left:4px}.tags{display:flex;flex-wrap:wrap;gap:8px}.tags span{border:1px solid #27374d;color:#a1b3c9;font-size:10px;padding:3px 10px;border-radius:4px}.capabilities{border-top:1px solid #27374d;margin-top:30px;padding:42px 0;display:grid;grid-template-columns:1fr 1.7fr;gap:35px}.capabilities h2{font-size:23px;margin-top:12px}.capabilities dl{margin:0}.capabilities dl>div{display:grid;grid-template-columns:90px 1fr;gap:18px;padding:12px 0;border-bottom:1px solid #27374d;font-size:12px}.capabilities dt{color:#9cd9ef}.capabilities dd{margin:0;color:#b3c4d8}footer{border-top:1px solid #27374d;padding:55px 0 25px}footer h2{font-family:"Noto Serif SC",serif;font-size:32px;margin:20px 0 28px}.footer-links{display:flex;gap:25px;font-size:11px;color:#a1b3c9;padding-top:40px}.footer-links>span{margin-left:auto}
  @media(max-width:960px){.intro-grid{grid-template-columns:1fr 220px;gap:28px}.identity{padding-left:22px}.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.loop{grid-template-columns:1fr}.loop ol{min-height:60px}.timeline article{grid-template-columns:180px 1fr;gap:25px}.metrics>div{padding:0 14px}}
  @media(max-width:640px){nav{height:66px;padding:0 22px}nav>div{gap:14px;font-size:11px}.brand{font-size:16px}main{padding:0 22px}.intro{padding-top:35px}.eyebrow{font-size:9px;letter-spacing:.09em}.intro-grid{grid-template-columns:1fr;gap:32px;margin-top:20px}.role{font-size:14px}h1{font-size:28px;line-height:1.65}.summary{font-size:14px;margin-top:20px}.identity{border-left:2px solid #9cd9ef;padding-left:18px}.identity-star,.identity ul,.identity .education{display:none}.identity h2{font-size:22px}.identity p{margin:5px 0}.identity>a{font-size:11px}.metrics{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 0;margin-top:32px;padding:24px 0}.metrics>div{padding-left:18px}.metrics>div:nth-child(odd){border:0;padding-left:0}.metrics strong{font-size:21px}.metrics small{font-size:9px}.loop{padding:22px 18px;margin:32px 0 55px;gap:20px}.loop ol{grid-template-columns:repeat(2,1fr);gap:22px}.loop li:nth-child(2):after{display:none}.loop h2{font-size:18px}.section-heading{display:block}.section-heading>p{margin-top:14px}h2{font-size:24px}.project-grid{grid-template-columns:1fr}.project-grid article{padding:23px}.result{font-size:27px}.timeline article{grid-template-columns:1fr;gap:14px}.when span{margin-top:3px}.timeline h3{font-size:20px}#experience{margin-top:60px}.capabilities{grid-template-columns:1fr;gap:20px}.capabilities dl>div{grid-template-columns:75px 1fr;gap:12px}footer h2{font-size:27px}.footer-links{gap:18px;flex-wrap:wrap}.footer-links>span{width:100%;margin:0}.actions{gap:20px;font-size:11px}}
  @media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
  @media print{:global(html){background:white;color:#12243b}:global(body){font-size:11px}nav,.actions,.loop,.footer-links,footer .button{display:none}main{max-width:none;padding:0}.intro{padding:0}.intro-grid{grid-template-columns:1fr 240px}.identity,.metrics,.timeline article{border-color:#bbb}.summary,.timeline p:not(.job),.timeline ul,.project-grid p{color:#334}.project-grid{grid-template-columns:repeat(2,1fr)}.project-grid article{background:#f6f8fb;break-inside:avoid;border-color:#ccc}.metrics strong,.result,.when,.job,.eyebrow{color:#1d5fa8}.project-grid details{display:none}.project-grid article,.timeline article{break-inside:avoid}#projects{margin-top:30px}.metrics{margin-top:25px}.source-note{color:#556}footer{padding-top:25px}}
</style>
